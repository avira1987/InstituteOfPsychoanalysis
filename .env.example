# ─── Database (فقط PostgreSQL) ───────────────────────────────────
# محلی: Postgres روی localhost با پورت 5432 (docker compose پورت db را publish می‌کند)
DATABASE_URL=postgresql+asyncpg://anistito:anistito@localhost:5432/anistito
DATABASE_URL_SYNC=postgresql://anistito:anistito@localhost:5432/anistito
DATABASE_ECHO=false

# اندازهٔ استخر اتصال SQLAlchemy؛ روی VPS کوچک (۲ گیگ) همین مقادیر امن هستند، روی سرور بزرگ‌تر می‌توانید بالا ببرید
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_POOL_TIMEOUT_SECONDS=30

# تست pytest (اختیاری): اگر خالی باشد همان anistito استفاده می‌شود — tests/conftest.py
# TEST_DATABASE_URL=postgresql+asyncpg://anistito:anistito@127.0.0.1:5432/anistito
# اجرای pytest بدون پاک کردن جداول در پایان: PYTEST_SKIP_DROP_ALL=1

# Docker production (docker-compose.prod.yml): اگر 1 باشد، در استارت کانتینر api دستور alembic upgrade و repair اسکیما اجرا نمی‌شود
# SKIP_ALEMBIC_UPGRADE=0

# رمز کاربران دانشجوی دمو (AUTO-DEMO-*) در seed
DEMO_MATRIX_STUDENT_PASSWORD=demo_student_123

# اگر true و هیچ دانشجویی در DB نباشد، با استارت API همان دیتابیس با دمو پر می‌شود (برای Docker توصیه می‌شود)
SEED_DEMO_ON_STARTUP=false
SEED_DEMO_FULL_MATRIX=false

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Application ─────────────────────────────────────────────────
# مسیر جایگزین برای فایل env (پیش‌فرض pydantic: <ریشهٔ مخزن>/.env)
# ANISTITO_ENV_FILE=/absolute/path/to/.env
# لوکال: true — روی اینترنت: false (اجباری)
DEBUG=true
# رمز اولیه ادمین اگر هنوز ساخته نشده (در production اجباری/قوی؛ در DEBUG بدون این مقدار admin123)
# INITIAL_ADMIN_PASSWORD=
ALLOW_DEMO_SEED=false
FLOW_THROUGH_SEED_ENABLED=false
# در Docker با alembic upgrade در command: false — جلوگیری از تداخل create_all با مایگریشن
# محلی بدون Alembic می‌توانید true بگذارید
INIT_DB_ON_STARTUP=true
# CORS: دامنه‌های مجاز با کاما (نه *؛ در DEBUG=false مقدار * و http:// رد می‌شود)
# هم‌تراز پیش‌فرض app/config.py و scripts/deploy_internet_host.py
CORS_ALLOW_ORIGINS=https://lms.psychoanalysis.ir,https://ims.psychoanalysis.ir
# لوکال اگر فرانت بدون پروکسی Vite مستقیم به API بزند:
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://lms.psychoanalysis.ir
APP_NAME=Anistito - Educational Automation System
APP_VERSION=1.0.0

# ─── Observability (لاگ ساخت‌یافته + Sentry) ───────────────────
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# LOG_SERVICE_NAME=anistito-api
# ENVIRONMENT=production
# LOG_FILE=   # خالی = فقط stdout (توصیه در Docker)
# LOG_ACCESS_SAMPLE_RATE=1.0
# SLOW_REQUEST_MS=1000
# SLOW_SQL_MS=500
# SENTRY_DSN=
# SENTRY_DSN_FRONTEND=
# SENTRY_TRACES_SAMPLE_RATE=0

# Production base URL (for links in SMS/email, etc.)
# APP_BASE_URL=https://lms.psychoanalysis.ir/anistito

# ─── Auth ────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-real-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_RATE_LIMIT_COUNT=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600

# مسئول اولیهٔ تیکت‌ها (نام کاربری). خالی = اولین کاربر staff فعال.
# TICKET_TRIAGE_USERNAME=staff1

# ─── SMS ─────────────────────────────────────────────────────────
# Options: "log" (فقط لاگ، بدون ارسال) | "mellipayamak"
SMS_PROVIDER=log
# تا وقتی SMS_PROVIDER=log است ذخیره می‌شود؛ با mellipayamak و mirror زیر هم outbox پر می‌شود.
# مرکز / production: false — پاپ‌آپ پیامک تستی در UI خاموش می‌شود
SMS_SIMULATION_UI=false
# با SMS_PROVIDER=mellipayamak: پس از ارسال واقعی متن در outbox برای پاپ‌آپ (برای تست لوکال true)
SMS_SIMULATION_MIRROR_REAL_SEND=false
# با true هر پیامک شبیه‌سازی‌شده به هر گیرنده در پاپ‌آپ نشان داده می‌شود (فقط غیردانشجو مگر نقش‌ها را محدود کنید)
SMS_SIMULATION_POPUP_SHOW_ALL=false
# خالی یعنی هر نقشی به جز student؛ یا مثلاً admin,staff,finance (فقط همان نقش‌ها فید یکپارچه می‌بینند)
# SMS_SIMULATION_POPUP_WATCHER_ROLES=
# ملی‌پیامک — روی rest.payamak-panel.com پارامتر password می‌تواند «رمز وب‌سرویس» یا همان APIKey پنل باشد (راهنمای پنل: APIKey به‌جای Password).
# اگر روی هاست پیام OTP با «name resolution» شکست خورد، DNS مرکز‌داده یا payamak را بلاک کرده؛ در docker-compose.prod.yml extra_hosts برای rest.payamak-panel.com ست شده؛ IP را با
#   python -c "import socket; print(socket.gethostbyname('rest.payamak-panel.com'))"
# از شبکهٔ عادی هر چند وقت یک‌بار چک کنید.
# ترجیح: SMS_USERNAME + (SMS_PASSWORD یا خالی با SMS_API_KEY=همان APIKey) + SMS_LINE_NUMBER → SendOtp / SendSMS
# اگر SMS_USERNAME خالی باشد: فقط SMS_API_KEY (توکن کنسول) → POST .../api/send/simple/{token}
# نام کاربری پنل؛ اغلب شماره موبایل ۱۰ رقمی (مثال: 9032054361)
SMS_USERNAME=
# رمز وب‌سرویس؛ یا خالی + SMS_API_KEY=APIKey پنل → همان APIKey به‌عنوان password در rest
SMS_PASSWORD=
SMS_API_KEY=your-mellipayamak-api-key-or-console-token-here
# شماره خط ارسال (الزامی برای SendSMS / SendOtp؛ برای پترن خط اشتراکی لازم نیست)
SMS_LINE_NUMBER=3000xxxx
# پترن خط خدماتی برای کد ورود OTP (0=فقط SendOtp). نگاشت سایر قالب‌های اعلان: metadata/sms_template_pattern_map.json
SMS_OTP_PATTERN_BODY_ID=449667
# legacy (دیگر برای ارسال متن آزاد استفاده نمی‌شود)
SMS_PATTERN_BODY_ID=0
# اختیاری: مسیر نگاشت template → bodyId (پیش‌فرض metadata/sms_template_pattern_map.json)
# SMS_TEMPLATE_PATTERN_MAP_JSON=
# اختیاری: مسیر JSON خروجی اسکریپت import اکسل پترن‌ها؛ پیش‌فرض metadata/melipayamak_patterns.json
# MELIPAYAMAK_PATTERNS_JSON=

# ورود دانشجو با موبایل (OTP): با SMS_PROVIDER=mellipayamak کد به شماره ارسال می‌شود.
# ALLOW_PUBLIC_OTP_SIGNUP=true: شمارهٔ ناشناس هم کد می‌گیرد و بعد از تأیید به فرم ثبت‌نام می‌رود.
# برای بستن ثبت‌نام عمومی: ALLOW_PUBLIC_OTP_SIGNUP=false و OTP_RESTRICT_TO_STUDENT_PHONES=true
OTP_RESTRICT_TO_STUDENT_PHONES=true
ALLOW_PUBLIC_OTP_SIGNUP=true
# نمایش کد OTP در پاسخ API و روی صفحه ورود (برای توسعه؛ در production حتماً false)
OTP_SHOW_CODE_IN_UI=false
# پس از اولین ورود موفق دانشجو با OTP: پیامک خوش‌آمد + رمز ساده برای ورود بدون پیامک (مسیر «ورود پرسنل»)
# خوش‌آمد + نام کاربری/رمز پورتال: با پترن 450373 (نگاشت student_portal_welcome_credentials در sms_template_pattern_map.json)
STUDENT_FIRST_LOGIN_WELCOME_SMS=true

# ─── External integration (LMS / وب‌هوک اکشن‌های متادیتا) ───────────
# اگر خالی باشد، فقط روی process_instances.context_data.integration_events ثبت می‌شود.
LMS_INTEGRATION_WEBHOOK_URL=
LMS_INTEGRATION_SECRET=

# ─── الوکام (کلاس آنلاین) ───────────────────────────────────────
# نمایش لینک مصاحبه آنلاین برای دانشجو/مصاحبه‌گر از چند دقیقه قبل از شروع
# INTERVIEW_ONLINE_LINK_VISIBLE_MINUTES_BEFORE=30
# برای لینک کلاس آنلاین مصاحبه/درمان باید فعال باشد
ALOCOM_ENABLED=true
ALOCOM_API_BASE=https://pnlapi.alocom.co
ALOCOM_USERNAME=
ALOCOM_PASSWORD=
ALOCOM_DEFAULT_AGENT_SERVICE_ID=138048
# مسیرهای پیش‌فرض با API فعلی pnlapi.alocom.co هم‌خوان است؛ در صورت تغییر نسخه فقط در صورت 404 تنظیم کنید.
# ALOCOM_PATH_LOGIN=/api/v1/auth/login
# ALOCOM_PATH_CREATE_EVENT=/api/v1/agents/events
# ALOCOM_PATH_REGISTER_IN_EVENT=/api/v1/agents/events/{event_id}/enroll-user-with-token
# ALOCOM_PATH_CREATE_USER=/api/v1/agents/users
ALOCOM_FALLBACK_TO_UI_HINTS=true

# ─── Payment ─────────────────────────────────────────────────────
# mock | zibal (اولویت) | saman | zarinpal — مبلغ API به ریال؛ دفتر کل داخلی به تومان
# PAYMENT_PROVIDER=zibal و PAYMENT_ZIBAL_ONLY=false → زیبال اول؛ اگر ساخت پرداخت زیبال شکست بخورد سپ
PAYMENT_PROVIDER=zibal
PAYMENT_ZIBAL_ONLY=false
# حالت تست: true → درگاه واقعی موقتاً غیرفعال و پرداخت بلافاصله «موفق» فرض می‌شود تا کل
# جریان فرایند در سامانه قابل تست باشد. برای بازگرداندن درگاه واقعی این مقدار را false کنید
# یا این خط را حذف کنید (هیچ کدِ درگاهی حذف نشده است).
PAYMENT_TEST_BYPASS=false
# کال‌بک درگاه (پس از پرداخت بانک کاربر به این URL برمی‌گردد). باید با ثبت پنل سامان/شاپرک دقیقاً یکی باشد و با https.
# اگر فقط APP_BASE_URL=https... را دارد اما هنوز localhost اینجا مانده، در کد effective_payment_callback_url() از روی APP_BASE_URL ساخته می‌شود.
# پنل بانک سامان: «آدرس بازگشت / Return URL / RedirectUrl» = همان چیزی که اینجا + در SendToken ارسال می‌شود (مثال):
#   https://lms.example.ir/anistito/api/payment/callback
PAYMENT_CALLBACK_URL=http://localhost:3000/api/payment/callback
# بعد از کال‌بک، مرورگر به APP_BASE_URL + این مسیر ریدایرکت می‌شود (پیش‌فرض: پنل دانشجو)
# PAYMENT_RETURN_PATH=/panel/portal/student

# Saman (SEP) — مقادیر واقعی را فقط در .env محلی/سرور بگذارید، نه در git
SEP_TERMINAL_ID=
SEP_PASSWORD=

# زیبال — کد مرچنت از my.zibal.ir
ZIBAL_MERCHANT=
# true=sandbox.zibal.ir  false=gateway.zibal.ir
ZIBAL_SANDBOX=false
# اگر API خطای «invalid IP» داد: در پنل زیبال IP عمومی سروری که uvicorn روی آن است را در «IP مجاز» ثبت کنید (نه IP داخلی Docker).

# Zarinpal (زرین‌پال) — merchant_id از پنل؛ اگر UI گزینهٔ zarinpal را بزند لازم است
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# ─── Email ───────────────────────────────────────────────────────
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM=noreply@anistito.ir

# ─── SLA ─────────────────────────────────────────────────────────
SLA_CHECK_INTERVAL_SECONDS=300

# ─── تریگرهای تقویمی (payment_timeout، یادآوری مرخصی، session_time_reached، …) ─
CALENDAR_TRIGGERS_ENABLED=true
CALENDAR_TRIGGER_INTERVAL_SECONDS=300
# یادآوری پیامکی مصاحبهٔ پذیرش (ساعت قبل از شروع اسلات رزروشده)
INTERVIEW_REMINDER_HOURS_BEFORE=2

# مرخصی آموزشی — یادآوری بازگشت و مهلت اعلام ثبت‌نام ترم، از زمان فعال‌سازی وقفه در سامانه (روز) محاسبه می‌شود؛ تاریخ شمس ثابت در کد نیست.
EDUCATIONAL_LEAVE_RETURN_REMINDER_OFFSET_DAYS=90
EDUCATIONAL_LEAVE_RETURN_DEADLINE_AFTER_REMINDER_DAYS=30

# ─── بکاپ روزانه (docker-compose.prod.yml + scripts/backup_daily.sh) ─
# مسیر داخل کانتینر api (bind-mount فقط‌خواندنی از هاست)
# BACKUP_DIR=/backups
# مسیر روی هاست که به /backups مانت می‌شود
# HOST_BACKUP_DIR=/var/backups/anistito

# ─── استقرار (scripts/deploy_to_host.py، فقط لوکال) ───────────────
# کلید SSH برای اسکریپت؛ روی سرور در .env اختیاری و توصیه نمی‌شود (فقط نیاز لوکال)
# DEPLOY_SSH_PASSWORD=
# نام متغیر فقط [A-Za-z0-9_] — پرانتز در نام ممنوع (Docker Compose)
# DEPLOY_REFERENCE_HOST=...
# DEPLOY_REFERENCE_PORT=...
# DEPLOY_REFERENCE_USER=
# DEPLOY_REFERENCE_PATH=/opt/anistito
# DEPLOY_PRESERVE_REMOTE_DB=1  # بدون pg_restore روی سرور

# بررسی سلامت لاگ سرور بعد از دیپلوی: python scripts/ssh_remote_health_logs.py