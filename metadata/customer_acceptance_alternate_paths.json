{
  "schema_version": 1,
  "description_fa": "مسیرهای UI/API جایگزین فرم متادیتا — برای ممیزی پذیرش مشتری بدون FAIL کاذب",
  "auto_start_paths": {
    "attendance_tracking": {
      "backend": "app/services/attendance_tracking_sync.py",
      "function": "ensure_attendance_instance_for_session",
      "note_fa": "یک نمونه per TherapySession؛ تریگر session_time_reached در calendar_triggers"
    },
    "supervision_50h_completion": {
      "backend": "app/services/calendar_triggers.py",
      "trigger": "session_time_reached",
      "note_fa": "هم‌تراز با attendance_tracking برای سوپرویژن"
    },
    "session_payment": {
      "backend": "app/api/payment_routes.py",
      "note_fa": "شروع از StudentPortal/SepPaymentPanel پس از جلسه درمانی"
    },
    "fee_determination": {
      "backend": "app/services/fee_determination_runner.py",
      "function": "sweep_stuck_fee_determination_triggered",
      "note_fa": "فراخوانی از start_process والد (attendance/cancellation)"
    },
    "violation_registration": {
      "backend": "app/services/action_handler.py",
      "action": "start_process",
      "note_fa": "زیرفرایند؛ از والد start_process می‌شود"
    },
    "patient_referral": {
      "backend": "app/services/action_handler.py",
      "action": "run_patient_referral",
      "note_fa": "زیرفرایند؛ از educational_leave و سایر والدها"
    }
  },
