{
  "process": {
    "code": "film_observation_course_completion",
    "name_fa": "خاتمه هر درس عملی کاربردی و مشاهده فیلم‌ها",
    "name_en": "Film Observation Course Completion",
    "number": 64,
    "description": "خاتمه درس عملی کاربردی و مشاهده فیلم‌ها: ثبت نمرات و ارزیابی نهایی. قفل نمره پس از مهلت.",
    "initial_state": "grades_entry",
    "initial_role": "instructor",
    "requires_form": true
  },
  "states": [
    {
      "code": "grades_entry",
      "name_fa": "ثبت نمرات و ارزیابی",
      "type": "initial",
      "assigned_role": "instructor",
      "metadata": {
        "operator_task_fa": "ثبت نمره/حضور/تأیید TA.",
        "operator_short_fa": "ثبت نمرات و ارزیابی",
        "student_short_fa": "ثبت نمرات و ارزیابی",
        "student_task_fa": "گزارش پایانی درس را فقط به‌صورت PDF آپلود کنید. فرم از پایان جلسه ۱۷ باز و در ۲۴:۰۰ روز جلسه ۱۸ بسته می‌شود.",
        "student_why_fa": "گزارش پایانی درس را فقط به‌صورت PDF آپلود کنید. فرم از پایان جلسه ۱۷ باز و در ۲۴:۰۰ روز جلسه ۱۸ بسته می‌شود."
      },
      "sla_days": 7
    },
    {
      "code": "grades_locked",
      "name_fa": "نمرات قفل شد",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "نمرات قفل شد",
        "student_task_fa": "نمره گزارش ثبت شد. اگر نمره نهایی شما در بازه مرزی ۶۴ تا ۷۳ باشد، می‌توانید امتحان مجدد یا دوباره گذراندن درس را انتخاب کنید.",
        "student_why_fa": "نمره گزارش ثبت شد. اگر نمره نهایی شما در بازه مرزی ۶۴ تا ۷۳ باشد، می‌توانید امتحان مجدد یا دوباره گذراندن درس را انتخاب کنید."
      }
    },
    {
      "code": "delay_reported",
      "name_fa": "تاخیر گزارش به کمیته",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "تاخیر گزارش به کمیته",
        "student_task_fa": "مهلت ثبت یا تصحیح گزارش گذشته است. برای پیگیری با دفتر آموزش تماس بگیرید.",
        "student_why_fa": "مهلت ثبت یا تصحیح گزارش گذشته است. برای پیگیری با دفتر آموزش تماس بگیرید."
      }
    }
  ],
  "transitions": [
    {
      "from": "grades_entry",
      "to": "grades_locked",
      "trigger": "grades_submitted",
      "required_role": "instructor",
      "conditions": [
        "course_grades_submitted_in_time"
      ],
      "description_fa": "ثبت نمرات و قفل",
      "actions": [
        {
          "type": "record_course_grades"
        }
      ]
    },
    {
      "from": "grades_entry",
      "to": "delay_reported",
      "trigger": "sla_breach",
      "conditions": [
        "course_grades_sla_breach"
      ],
      "description_fa": "گذشت مهلت و گزارش",
      "required_role": "system"
    }
  ],
  "forms": [
    {
      "code": "film_observation_final_report_form",
      "name_fa": "آپلود گزارش پایانی درس",
      "used_in_state": "grades_entry",
      "visible_to": [
        "student"
      ],
      "fields": [
        {
          "name": "course_name",
          "label_fa": "نام درس",
          "type": "readonly"
        },
        {
          "name": "final_report_pdf",
          "label_fa": "گزارش پایانی PDF",
          "type": "file_upload",
          "accept": ".pdf,application/pdf",
          "required": true,
          "validation": {
            "max_size_mb": 25
          },
          "note_fa": "فقط PDF — از پایان جلسه ۱۷ تا ۲۴:۰۰ روز جلسه ۱۸."
        }
      ]
    },
    {
      "code": "film_observation_grades_form",
      "name_fa": "ثبت نمرات مشاهده فیلم و عملی کاربردی",
      "used_in_state": "grades_entry",
      "visible_to": [
        "instructor",
        "teaching_assistant",
        "admin",
        "staff"
      ],
      "fields": [
        {
          "name": "course_name",
          "label_fa": "نام درس",
          "type": "readonly"
        },
        {
          "name": "students_grades",
          "label_fa": "لیست دانشجویان و نمرات",
          "type": "dynamic_list",
          "fields": [
            "student_name",
            "student_id",
            "grade"
          ]
        }
      ]
    }
  ],
  "scheduled_automation": {
    "mode": "instance_sla",
    "completion_role": "instructor",
    "sla_state": "grades_entry",
    "sla_days": 7,
    "triggers": [
      {
        "event": "sla_breach",
        "actor_role": "system"
      }
    ]
  }
}
