  "transitions": [
    {
      "from": "deadline_reached",
      "to": "supervision_review",
      "trigger": "alert_to_supervision",
      "description_fa": "هشدار به مسئول علمی اجرایی کمیته نظارت",
      "required_role": "system"
    },
    {
      "from": "supervision_review",
      "to": "rejected_referral",
      "trigger": "rejected",
      "required_role": "supervision_committee",
      "actions": [
        {
          "type": "refer_to_violation_registration"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "intern_hours_increase_deferred",
          "recipients": [
            "student"
          ]
        }
      ]
    },
    {
      "from": "supervision_review",
      "to": "approved_time_coordination",
      "trigger": "approved",
      "required_role": "supervision_committee",
      "description_fa": "تایید صلاحیت — ثبت زمان‌ها در شیت وقت‌های آزاد"
    },
    {
      "from": "approved_time_coordination",
      "to": "hours_increased",
      "trigger": "times_registered",
      "required_role": "supervision_committee",
      "actions": [
        {
          "type": "increase_intern_capacity"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "intern_hours_increased",
          "recipients": [
            "student"
          ]
        }
      ]
    }
  ],
  "forms": [
    {
      "code": "intern_hours_approval",
      "name_fa": "تایید افزایش ظرفیت انترن",
      "used_in_state": "supervision_review",
      "fields": [
        {
          "name": "disciplinary_status",
          "label_fa": "وضعیت انضباطی",
          "type": "radio",
          "options": [
            {
              "value": "no_violation",
              "label_fa": "فاقد تخلف"
            },
            {
              "value": "has_violation",
              "label_fa": "دارای تخلف — ارجاع به کمیته تخلفات"
            }
          ]
        },
        {
          "name": "agreed_times",
          "label_fa": "زمان‌های توافق شده",
          "type": "dynamic_list",
          "fields": [
            "day",
            "start_time",
            "end_time"
          ]
        }
      ]
    }
  ],
  "scheduled_automation": {
    "mode": "milestone",
    "completion_role": "supervision_committee",
    "triggers": [
      {
        "event": "intern_month_milestone_reached",
        "months": [
          4,
          7,
          12,
          16,
          20,
          24,
          28
        ]
      }
    ]
  }
