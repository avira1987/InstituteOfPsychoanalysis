{
  "process": {
    "code": "introductory_term_end",
    "name_fa": "فرایند پایان ترم‌های دوره آشنایی",
    "name_en": "Introductory Course Term End",
    "number": 32,
    "description": "فرایند خودکار پایان ترم دوره آشنایی. تریگر: ثبت تمام نمرات توسط اساتید. شامل: تولید کارنامه ترمی (درس، واحد، نمره عددی، نمره حرفی، وضعیت قبولی)، تولید کارنامه کلی تجمیعی (تمام ترم‌ها + بخش‌های درمان/سوپرویژن/کمیته — فرمت آقای صالحی)، بررسی شرط درمان برای دانشجویان مشروط، مسدودیت ثبت‌نام ترم ۲ در صورت عدم ثبت درمانگر، اطلاع‌رسانی ثبت‌نام ترم بعد، شناسایی دانشجویان افت تحصیلی و پیگیری توسط مسئول پذیرش. مردودی: واحد=۰ اما در معدل حساب می‌شود.",
    "initial_state": "grades_submitted",
    "trigger_event": "all_instructor_grades_entered"
  },
  "states": [
    {
      "code": "grades_submitted",
      "name_fa": "تمام نمرات ثبت شد — شروع فرایند",
      "type": "initial",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "نمرات ثبت شد",
        "student_task_fa": "سامانه در حال تولید کارنامه ترمی و تجمیعی است؛ چند دقیقه بعد صفحه را تازه کنید.",
        "student_why_fa": "تمام نمرات ترم توسط اساتید ثبت شده است. سامانه کارنامه‌های شما را تولید می‌کند."
      }
    },
    {
      "code": "transcript_generated",
      "name_fa": "کارنامه ترمی و تجمیعی تولید شد",
      "type": "intermediate",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "کارنامه آماده",
        "student_task_fa": "کارنامه ترمی و تجمیعی در تب پروفایل قابل مشاهده است؛ مراحل بعد خودکار ادامه می‌یابد.",
        "student_why_fa": "کارنامه ترمی و تجمیعی شما آماده است. از بخش «کارنامه‌ها» در تب پروفایل می‌توانید آن را مشاهده یا دانلود کنید."
      }
    },
    {
      "code": "therapy_check",
      "name_fa": "بررسی وضعیت شرط درمان",
      "type": "intermediate",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "بررسی شرط درمان",
        "student_task_fa": "سامانه در حال بررسی شرط درمان است؛ در صورت نیاز به اقدام، در همین صفحه اعلام می‌شود.",
        "student_why_fa": "برای دانشجویان مشروط به درمان، وضعیت ثبت درمانگر بررسی می‌شود."
      }
    },
    {
      "code": "therapy_blocked",
      "name_fa": "مسدودیت ثبت‌نام — درمانگر فعال ندارد",
      "type": "intermediate",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "مسدودیت ثبت‌نام ترم دوم",
        "student_task_fa": "از فرایند «آغاز درمان آموزشی» در پورتال اقدام کنید تا مسدودیت ثبت‌نام ترم دوم برداشته شود.",
        "student_why_fa": "طبق توافق قبلی در مورد پذیرش شما به دوره آشنایی، باید وارد درمان شخصی شوید. چون این شرط تاکنون انجام نگرفته، ثبت‌نام در ترم دوم این دوره مشروط به آغاز این درمان شده است."
      }
    },
    {
      "code": "registration_notification_sent",
      "name_fa": "پیامک اطلاع‌رسانی ثبت‌نام ارسال شد",
      "type": "intermediate",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "مهلت ثبت‌نام ترم بعد",
        "student_task_fa": "در مهلت اعلام‌شده دروس ترم بعد را انتخاب و شهریه را پرداخت کنید.",
        "student_why_fa": "پیامک مهلت ثبت‌نام ترم بعد برای شما ارسال شده است. در مهلت اعلام‌شده دروس ترم بعد را انتخاب و شهریه را پرداخت کنید."
      }
    },
    {
      "code": "decline_list_generated",
      "name_fa": "لیست دانشجویان افت تحصیلی تولید شد",
      "type": "intermediate",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "پیگیری افت تحصیلی",
        "student_task_fa": "فرایند پایان ترم در حال تکمیل است؛ در صورت افت تحصیلی، مسئول پذیرش ممکن است با شما تماس بگیرد.",
        "student_why_fa": "در صورت افت تحصیلی، مسئول پذیرش ممکن است با شما تماس بگیرد؛ اگر اقدامی از سمت شما لازم باشد، در همین صفحه اعلام می‌شود."
      }
    },
    {
      "code": "followup_in_progress",
      "name_fa": "پیگیری تماس با دانشجویان افت تحصیلی",
      "type": "intermediate",
      "assigned_role": "admissions_officer",
      "sla_hours": 168,
      "metadata": {
        "student_short_fa": "پیگیری افت تحصیلی توسط پذیرش",
        "student_task_fa": "در این مرحله مسئول پذیرش با فهرست دانشجویان افت تحصیلی تماس می‌گیرد؛ اگر برای شما پیام یا تماس ثبت شد همان را دنبال کنید. اگر اقدامی از سمت شما در پنل باز نشده، همین صفحه را بعداً تازه کنید — نیاز به اقدام فوری در پنل نیست مگر اعلام شده باشد.",
        "student_why_fa": "مسئول پذیرش در حال پیگیری دانشجویان افت تحصیلی است. اگر برای شما تماس یا پیام ثبت شد، همان را دنبال کنید؛ در غیر این صورت نیازی به اقدام فوری در پنل نیست.",
        "operator_task_fa": "بررسی مدارک/پرونده؛ تأیید، نقص، یا ادامه.",
        "operator_short_fa": "پیگیری تماس با دانشجویان افت تحصیلی"
      }
    },
    {
      "code": "followup_complete",
      "name_fa": "پیگیری تکمیل شد",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "پایان ترم تکمیل شد",
        "student_task_fa": "کارنامه‌ها در تب پروفایل در دسترس است؛ برای ترم بعد طبق پیامک و راهنمای پنل اقدام کنید.",
        "student_why_fa": "فرایند پایان ترم تکمیل شد. کارنامه‌ها در تب پروفایل در دسترس است؛ برای ترم بعد طبق پیامک و راهنمای پنل اقدام کنید."
      }
    }
  ],
  "transitions": [
    {
      "from": "grades_submitted",
      "to": "transcript_generated",
      "trigger": "auto_generate_transcripts",
      "description_fa": "تولید خودکار کارنامه ترمی و کارنامه تجمیعی (فرمت آقای صالحی) — دروس مردودی: واحد=۰ اما در معدل حساب می‌شود",
      "actions": [
        {
          "type": "generate_term_transcript",
          "description_fa": "تولید کارنامه ترمی شامل: نام درس، واحد، نمره عددی، نمره حرفی، وضعیت قبولی/مردودی"
        },
        {
          "type": "generate_cumulative_transcript",
          "description_fa": "تولید کارنامه تجمیعی تمام ترم‌ها شامل بخش‌های درمان آموزشی، سوپرویژن و گزارشات کمیته — فرمت آقای صالحی",
          "failed_course_logic": "واحد=۰ اما نمره در محاسبه معدل لحاظ می‌شود"
        },
        {
          "type": "enable_pdf_export",
          "description_fa": "فعال‌سازی خروجی PDF برای کارنامه‌ها"
        }
      ],
      "required_role": "system"
    },
    {
      "from": "transcript_generated",
      "to": "therapy_check",
      "trigger": "transcripts_ready",
      "description_fa": "کارنامه‌ها آماده — بررسی وضعیت شرط درمان دانشجویان مشروط",
      "required_role": "system"
    },
    {
      "from": "therapy_check",
      "to": "therapy_blocked",
      "trigger": "therapy_condition_check",
      "conditions": [
        "admission_type == 'conditional_therapy'",
        "no_active_therapist_registered"
      ],
      "description_fa": "دانشجو مشروط به درمان بوده و هنوز درمانگر فعال ثبت نکرده — مسدودیت ثبت‌نام ترم ۲",
      "actions": [
        {
          "type": "block_next_term_registration",
          "description_fa": "مسدودیت ثبت‌نام ترم ۲ تا زمان ثبت درمانگر فعال"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "therapy_condition_block",
          "recipients": [
            "student"
          ],
          "description_fa": "پیامک اطلاع‌رسانی مسدودیت ثبت‌نام به دلیل عدم شروع درمان"
        }
      ],
      "required_role": "system"
    },
    {
      "from": "therapy_check",
      "to": "registration_notification_sent",
      "trigger": "therapy_condition_check",
      "conditions": [
        "therapy_condition_met_or_not_conditional"
      ],
      "description_fa": "شرط درمان احراز شده یا دانشجو مشروط نبوده — مجاز به ثبت‌نام ترم بعد",
      "required_role": "system"
    },
    {
      "from": "therapy_blocked",
      "to": "registration_notification_sent",
      "trigger": "therapist_registered_later",
      "conditions": [
        "active_therapist_registered"
      ],
      "description_fa": "دانشجو درمانگر فعال ثبت کرد — رفع مسدودیت",
      "actions": [
        {
          "type": "unblock_next_term_registration"
        }
      ],
      "required_role": "system"
    },
    {
      "from": "registration_notification_sent",
      "to": "decline_list_generated",
      "trigger": "send_registration_notification",
      "description_fa": "ارسال پیامک اطلاع‌رسانی مهلت ثبت‌نام ترم بعد به دانشجویان واجد شرایط",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "next_term_registration_open",
          "recipients": [
            "eligible_students"
          ],
          "description_fa": "ارسال پیامک مهلت ثبت‌نام ترم بعد"
        }
      ],
      "required_role": "system"
    },
    {
      "from": "decline_list_generated",
      "to": "followup_in_progress",
      "trigger": "decline_list_ready",
      "description_fa": "لیست دانشجویانی که همه دروس را پاس نکرده‌اند تولید و به داشبورد مسئول پذیرش ارسال شد",
      "actions": [
        {
          "type": "generate_decline_list",
          "description_fa": "شناسایی دانشجویانی که حداقل یک درس مردود دارند"
        },
        {
          "type": "send_to_dashboard",
          "target_role": "admissions_officer",
          "description_fa": "ارسال لیست به داشبورد مسئول پذیرش"
        }
      ],
      "required_role": "system"
    },
    {
      "from": "followup_in_progress",
      "to": "followup_complete",
      "trigger": "all_followups_done",
      "required_role": "admissions_officer",
      "description_fa": "مسئول پذیرش با تمام دانشجویان افت تحصیلی تماس گرفت و تیک پیگیری زد",
      "constraints": [
        "all_checkboxes_ticked"
      ]
    },
    {
      "from": "followup_in_progress",
      "to": "followup_in_progress",
      "trigger": "sla_warning",
      "conditions": [
        "sla_approaching_168h"
      ],
      "description_fa": "نزدیک شدن به مهلت ۷ روزه — هشدار به معاون مدیر آموزش",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "followup_sla_warning",
          "recipients": [
            "deputy_education"
          ],
          "description_fa": "هشدار تاخیر در پیگیری دانشجویان افت تحصیلی"
        }
      ],
      "required_role": "system"
    }
  ],
