{
  "process": {
    "code": "full_education_leave",
    "name_fa": "مرخصی موقت از کل آموزش",
    "name_en": "Temporary Leave from Full Education",
    "number": 59,
    "description": "درخواست مرخصی موقت از کل دوره آموزش. تعیین تکلیف درمانگر آموزشی و پرونده‌های بالینی. شامل: ثبت درخواست (۱ یا ۲ ترم)، جلسه کمیته پیشرفت ظرف ۷ روز، تصمیم کمیته، تعیین تکلیف درمانگر (۴ روز)، یادآوری بازگشت و فرایند ۶۰.",
    "initial_state": "leave_request",
    "initial_role": "student",
    "requires_form": true
  },
  "states": [
    {
      "code": "leave_request",
      "name_fa": "درخواست مرخصی از کل آموزش",
      "type": "initial",
      "assigned_role": "student",
      "metadata": {
        "student_short_fa": "ثبت درخواست مرخصی",
        "student_task_fa": "مدت مرخصی (۱ یا ۲ ترم) را انتخاب و درخواست را ارسال کنید. با اجرای این فرایند تمامی فعالیت‌های آموزشی به‌جز درمان آموزشی (در صورت تمایل) متوقف می‌شود.",
        "student_why_fa": "مرخصی از کل آموزش با تصویب کمیته، فعالیت‌های آموزشی را موقتاً متوقف می‌کند تا تعادل شخصی و الزامات آموزشی حفظ شود."
      }
    },
    {
      "code": "committee_review",
      "name_fa": "بررسی و تعیین جلسه توسط کمیته پیشرفت",
      "type": "intermediate",
      "assigned_role": "progress_committee",
      "sla_hours": 168,
      "on_sla_breach_event": "sla_breach_7days",
      "metadata": {
        "student_short_fa": "در انتظار کمیته پیشرفت",
        "student_task_fa": "کمیته پیشرفت در حال بررسی درخواست شماست. پس از تعیین جلسه، جزئیات در همین صفحه نمایش داده می‌شود؛ صفحه را بعداً تازه کنید.",
        "student_why_fa": "برای تصویب مرخصی از کل آموزش، جلسهٔ بررسی با کمیته پیشرفت الزامی است.",
        "operator_task_fa": "بررسی پرونده و ثبت زمان جلسه (حداکثر ۷ روز).",
        "operator_short_fa": "بررسی و تعیین جلسه"
      }
    },
    {
      "code": "deputy_alerted",
      "name_fa": "هشدار به معاون مدیر آموزش",
      "type": "intermediate",
      "assigned_role": "deputy_education",
      "metadata": {
        "reason": "عدم ثبت جلسه ظرف ۷ روز توسط کمیته پیشرفت",
        "student_short_fa": "در انتظار تعیین جلسه",
        "student_task_fa": "درخواست شما در صف بررسی کمیته است. به‌زودی زمان جلسه اعلام می‌شود؛ همین صفحه را تازه کنید.",
        "student_why_fa": "ثبت جلسه ظرف مهلت قانونی برای ادامهٔ بررسی درخواست شما ضروری است.",
        "operator_task_fa": "بررسی پرونده و ثبت جلسه.",
        "operator_short_fa": "هشدار به معاون آموزش"
      }
    },
    {
      "code": "session_scheduled",
      "name_fa": "جلسه تنظیم شد",
      "type": "intermediate",
      "assigned_role": "progress_committee",
      "metadata": {
        "student_short_fa": "زمان جلسه کمیته",
        "student_task_fa": "زمان و نحوهٔ برگزاری جلسه در همین صفحه نمایش داده می‌شود؛ در روز مقرر طبق اعلام کمیته حاضر شوید.",
        "student_why_fa": "حضور در جلسه کمیته برای توضیح درخواست و دریافت تصمیم نهایی لازم است.",
        "operator_short_fa": "جلسه تنظیم شد"
      }
    },
    {
      "code": "committee_decision",
      "name_fa": "برگزاری جلسه و تصمیم‌گیری",
      "type": "intermediate",
      "assigned_role": "progress_committee",
      "metadata": {
        "student_short_fa": "منتظر تصمیم کمیته",
        "student_task_fa": "جلسه کمیته برگزار شده یا در حال برگزاری است. نتیجهٔ نهایی از طریق کمیته اعلام می‌شود؛ صفحه را تازه کنید.",
        "student_why_fa": "پس از جلسه، تصمیم کمیته تعیین می‌کند آیا مرخصی شما تأیید می‌شود یا خیر.",
        "operator_task_fa": "پس از جلسه، تأیید یا رد درخواست را ثبت کنید.",
        "operator_short_fa": "تصمیم کمیته"
      }
    },
    {
      "code": "leave_rejected",
      "name_fa": "مرخصی رد شد",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "درخواست مرخصی رد شد",
        "student_task_fa": "شرح توافقات و علت رد در همین صفحه نمایش داده می‌شود.",
        "student_why_fa": "رد درخواست معمولاً به‌دلیل عدم انطباق با شرایط مرخصی یا اطلاعات ناقص است."
      }
    },
    {
      "code": "therapist_assignment",
      "name_fa": "تعیین تکلیف درمانگر آموزشی",
      "type": "intermediate",
      "assigned_role": "therapy_education_coordinator",
      "sla_hours": 96,
      "on_sla_breach_event": "sla_breach_4days",
      "metadata": {
        "student_short_fa": "تعیین تکلیف درمانگر",
        "student_task_fa": "در صورت تمایل به ادامه درمان، ظرف ۳ روز با مسئول هماهنگی‌ها تماس بگیرید. جزئیات در همین صفحه.",
        "student_why_fa": "پس از مرخصی، تکلیف درمانگر آموزشی و پرونده‌های بالینی باید مشخص شود.",
        "operator_task_fa": "تعیین تکلیف وقت درمانگر (مهلت ۴ روز).",
        "operator_short_fa": "تعیین تکلیف درمانگر"
      }
    },
    {
      "code": "on_leave",
      "name_fa": "در مرخصی از کل آموزش",
      "type": "intermediate",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "در مرخصی از کل آموزش",
        "student_task_fa": "ثبت‌نام دروس و فعالیت‌های آموزشی مسدود است. برای بازگشت، فرایند «بازگشت به کل آموزش» (فرایند ۶۰) را آغاز کنید.",
        "student_why_fa": "در دورهٔ مرخصی از کل آموزش، فعالیت‌های آموزشی متوقف است تا پس از بازگشت دوباره فعال شوند."
      }
    },
    {
      "code": "return_reminder_sent",
      "name_fa": "یادآوری بازگشت ارسال شد",
      "type": "intermediate",
      "assigned_role": "system",
      "sla_hours": 336,
      "metadata": {
        "student_short_fa": "بازگشت به کل آموزش",
        "student_task_fa": "مهلت بازگشت فرا رسیده است. فرایند «بازگشت به کل آموزش پس از مرخصی» (فرایند ۶۰) را آغاز و تکمیل کنید.",
        "student_why_fa": "پس از مهلت بازگشت، باید فرایند ۶۰ را تکمیل کنید تا دسترسی‌های آموزشی دوباره باز شود."
      }
    },
    {
      "code": "leave_complete",
      "name_fa": "بازگشت به کل آموزش انجام شد",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "بازگشت انجام شد",
        "student_task_fa": "بازگشت به کل آموزش با موفقیت انجام شد. ثبت‌نام دروس و ادامهٔ مسیر آموزشی از بخش‌های مربوط در پرتال در دسترس است.",
        "student_why_fa": "پس از تکمیل فرایند بازگشت، محدودیت‌های آموزشی برداشته می‌شود."
      }
    },
    {
      "code": "violation_registered",
      "name_fa": "ثبت تخلف عدم بازگشت",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "تخلف عدم بازگشت",
        "student_task_fa": "به‌دلیل عدم بازگشت در مهلت مقرر، گزارش تخلف ثبت شده است. برای پیگیری با کمیته نظارت یا پذیرش تماس بگیرید.",
        "student_why_fa": "عدم بازگشت در مهلت مقرر طبق قوانین موسسه به‌عنوان تخلف ثبت می‌شود."
      }
    }
  ],
  "transitions": [
    {
      "from": "leave_request",
      "to": "committee_review",
      "trigger": "student_submitted",
      "required_role": "student",
      "description_fa": "ارسال درخواست مرخصی از کل آموزش به کمیته پیشرفت",
      "actions": [
        {
          "type": "record_leave_request"
        },
        {
          "type": "warn_if",
          "condition": "student.is_intern AND leave_terms == 2",
          "message_fa": "دانشجوی گرامی، با توجه به وضعیت انترنی شما، مرخصی از کل آموزش منجر به توقف سوپرویژن فردی و ارجاع بیماران می‌شود. لطفاً جهت تسهیل فرایند با بیماران خود صحبت کنید."
        }
      ]
    },
    {
      "from": "committee_review",
      "to": "deputy_alerted",
      "trigger": "sla_breach_7days",
      "description_fa": "عدم ثبت جلسه ظرف ۷ روز — هشدار به معاون مدیر آموزش",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "committee_sla_breach",
          "recipients": ["deputy_education"]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "deputy_alerted",
      "to": "session_scheduled",
      "trigger": "committee_set_meeting",
      "required_role": "progress_committee",
      "description_fa": "ثبت جلسه پس از هشدار SLA"
    },
    {
      "from": "committee_review",
      "to": "session_scheduled",
      "trigger": "committee_set_meeting",
      "required_role": "progress_committee",
      "description_fa": "ثبت تاریخ، ساعت و نحوهٔ برگزاری جلسه (حداکثر ۷ روز)",
      "actions": [
        {
          "type": "notification",
          "notification_type": "email",
          "template": "meeting_scheduled",
          "recipients": ["student"]
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "meeting_scheduled_sms",
          "recipients": ["student"]
        }
      ]
    },
    {
      "from": "session_scheduled",
      "to": "committee_decision",
      "trigger": "meeting_held",
      "required_role": "progress_committee",
      "description_fa": "برگزاری جلسه و آماده‌سازی ثبت تصمیم"
    },
    {
      "from": "committee_decision",
      "to": "leave_rejected",
      "trigger": "committee_rejected",
      "required_role": "progress_committee",
      "description_fa": "رد درخواست — نمایش شرح توافق در پورتال دانشجو (بدون ارجاع به کمیته نظارت)",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "leave_rejected",
          "recipients": ["student"]
        }
      ]
    },
    {
      "from": "committee_decision",
      "to": "therapist_assignment",
      "trigger": "committee_approved",
      "required_role": "progress_committee",
      "description_fa": "تأیید مرخصی — اعمال محدودیت‌ها و ارجاع به مسئول هماهنگی درمان",
      "actions": [
        {
          "type": "set_full_education_leave_flag"
        },
        {
          "type": "block_next_term_registration"
        },
        {
          "type": "suspend_class_registration"
        },
        {
          "type": "set_leave_return_schedule"
        },
        {
          "type": "apply_full_leave_intern_effects"
        },
        {
          "type": "notify_therapy_coordination"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "leave_approved",
          "recipients": ["student"]
        }
      ]
    },
    {
      "from": "therapist_assignment",
      "to": "on_leave",
      "trigger": "therapist_assigned",
      "required_role": "therapy_education_coordinator",
      "description_fa": "ثبت تکلیف درمانگر توسط مسئول هماهنگی‌ها",
      "actions": [
        {
          "type": "apply_full_leave_therapist_decision"
        }
      ]
    },
    {
      "from": "therapist_assignment",
      "to": "on_leave",
      "trigger": "skip_therapist_assignment",
      "required_role": "system",
      "description_fa": "دانشجو درمانگر فعال ندارد — عبور از تعیین تکلیف"
    },
    {
      "from": "therapist_assignment",
      "to": "on_leave",
      "trigger": "sla_breach_4days",
      "required_role": "system",
      "description_fa": "عدم ثبت تکلیف درمانگر ظرف ۴ روز — آزادسازی خودکار وقت",
      "actions": [
        {
          "type": "auto_release_therapist_slot"
        }
      ]
    },
    {
      "from": "on_leave",
      "to": "return_reminder_sent",
      "trigger": "send_return_reminder",
      "description_fa": "یادآوری بازگشت — آغاز فرایند ۶۰",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "return_reminder",
          "recipients": ["student"]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "return_reminder_sent",
      "to": "violation_registered",
      "trigger": "return_deadline_passed",
      "description_fa": "عدم بازگشت تا ترم بعد — ثبت تخلف",
      "actions": [
        {
          "type": "start_process",
          "process_code": "violation_registration",
          "payload": {
            "reason": "no_return_from_full_education_leave"
          }
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "violation_no_return",
          "recipients": ["student", "monitoring_committee_officer"]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "on_leave",
      "to": "leave_complete",
      "trigger": "return_process_completed",
      "required_role": "system",
      "description_fa": "تکمیل فرایند ۶۰ بازگشت به کل آموزش",
      "actions": [
        {
          "type": "clear_full_education_leave_flag"
        },
        {
          "type": "unblock_next_term_registration"
        },
        {
          "type": "reactivate_class_registration"
        }
      ]
    },
    {
      "from": "return_reminder_sent",
      "to": "leave_complete",
      "trigger": "return_process_completed",
      "required_role": "system",
      "description_fa": "تکمیل فرایند ۶۰ پس از یادآوری",
      "actions": [
        {
          "type": "clear_full_education_leave_flag"
        },
        {
          "type": "unblock_next_term_registration"
        },
        {
          "type": "reactivate_class_registration"
        }
      ]
    }
  ],
