{
  "process": {
    "code": "comprehensive_term_start",
    "name_fa": "آغاز ترم‌های دوره جامع",
    "name_en": "Comprehensive Term Start",
    "number": 40,
    "description": "ثبت‌نام ترم جدید دوره جامع. بررسی تعلیق و مرخصی. دروس ثابت (بدون انتخاب واحد). پرداخت نقدی یا اقساطی (۲-۴ قسط). ثبت در حسابداری. SMS به واحد حسابداری. کنترل حضور: عدم پرداخت اقساط → قفل ثبت حضور.",
    "initial_state": "eligibility_check",
    "initial_role": "student"
  },
  "states": [
    {
      "code": "eligibility_check",
      "name_fa": "بررسی موانع (تعلیق/مرخصی)",
      "type": "initial",
      "assigned_role": "system"
    },
    {
      "code": "blocked",
      "name_fa": "مسدود — تعلیق یا مرخصی",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "مسدود — تعلیق یا مرخصی",
        "student_task_fa": "به دلیل تعلیق انضباطی یا مرخصی تحصیلی، ثبت‌نام ترم جدید مسدود است. برای رفع مانع با بخش آموزش تماس بگیرید.",
        "student_why_fa": "ثبت‌نام ترم جدید به‌خاطر تعلیق یا مرخصی تحصیلی مسدود شده است؛ برای ادامه باید مانع برطرف شود."
      }
    },
    {
      "code": "course_display",
      "name_fa": "نمایش دروس و شهریه",
      "type": "intermediate",
      "assigned_role": "student",
      "metadata": {
        "student_short_fa": "نمایش دروس و شهریه",
        "student_task_fa": "دروس ثابت ترم را مشاهده کنید و پس از تأیید، به مرحلهٔ انتخاب روش پرداخت بروید.",
        "student_why_fa": "در دوره جامع امکان حذف یا انتخاب اختیاری درس وجود ندارد؛ پس از مشاهده دروس ثابت، تأیید کنید تا به انتخاب روش پرداخت بروید."
      }
    },
    {
      "code": "payment_choice",
      "name_fa": "انتخاب نحوه پرداخت",
      "type": "intermediate",
      "assigned_role": "student",
      "metadata": {
        "student_short_fa": "انتخاب نحوه پرداخت",
        "student_task_fa": "روش پرداخت (نقدی یا ۲ تا ۴ قسط) را انتخاب کنید.",
        "student_why_fa": "روش پرداخت را انتخاب کنید: نقدی (یکجا) یا اقساطی (۲ تا ۴ قسط). قسط اول در زمان ثبت‌نام پرداخت می‌شود."
      }
    },
    {
      "code": "payment_processing",
      "name_fa": "پرداخت",
      "type": "intermediate",
      "assigned_role": "student",
      "metadata": {
        "student_short_fa": "پرداخت درگاه",
        "student_task_fa": "از بخش پرداخت سپ همین صفحه استفاده کنید. پس از بازگشت از بانک، صفحه را یک‌بار تازه کنید.",
        "student_why_fa": "از بخش پرداخت سپ همین صفحه استفاده کنید. پس از بازگشت از بانک، صفحه را یک‌بار تازه کنید تا تأیید پرداخت ثبت شود؛ در صورت خطا دوباره تلاش کنید."
      }
    },
    {
      "code": "registration_complete",
      "name_fa": "ثبت‌نام نهایی — لینک کلاس‌ها فعال",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "ثبت‌نام نهایی",
        "student_task_fa": "لینک کلاس‌های آنلاین فعال است؛ در صورت انتخاب پرداخت اقساطی، اقساط بعدی را در سررسید پرداخت کنید.",
        "student_why_fa": "ثبت‌نام شما در ترم جدید نهایی شد و لینک کلاس‌های آنلاین فعال است. در صورت انتخاب پرداخت اقساطی، اقساط بعدی را در سررسید پرداخت کنید."
      }
    }
  ],
  "transitions": [
    {
      "from": "eligibility_check",
      "to": "blocked",
      "trigger": "suspended_or_on_leave",
      "description_fa": "تعلیق یا مرخصی — Pop-up نمایش داده می‌شود",
      "required_role": "system"
    },
    {
      "from": "eligibility_check",
      "to": "course_display",
      "trigger": "eligible",
      "description_fa": "بدون مانع — نمایش دروس ثابت",
      "required_role": "system"
    },
    {
      "from": "course_display",
      "to": "payment_choice",
      "trigger": "courses_seen",
      "required_role": "student",
      "description_fa": "دانشجو نحوه پرداخت را انتخاب می‌کند (نقدی یا ۲-۴ قسط)"
    },
    {
      "from": "payment_choice",
      "to": "payment_processing",
      "trigger": "payment_initiated",
      "required_role": "student",
      "description_fa": "پرداخت کل یا قسط اول"
    },
    {
      "from": "payment_processing",
      "to": "registration_complete",
      "trigger": "payment_confirmed",
      "description_fa": "ثبت در حسابداری، SMS به واحد حسابداری، دروس فعال، لینک کلاس‌ها",
      "actions": [
        {
          "type": "record_accounting"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "tuition_payment_to_accounting",
          "recipients": [
            "accounting"
          ]
        }
      ],
      "required_role": "system"
    }
  ],
  "forms": [
    {
      "code": "comprehensive_term_courses",
      "name_fa": "دروس ترم دوره جامع",
      "used_in_state": "course_display",
      "fields": [
        {
          "name": "courses",
          "label_fa": "دروس ارائه شده (الزامی)",
          "type": "readonly_table"
        }
      ]
    },
    {
      "code": "comprehensive_term_payment",
      "name_fa": "انتخاب روش پرداخت ترم",
      "used_in_state": "payment_choice",
      "fields": [
        {
          "name": "payment_method",
          "label_fa": "نحوه پرداخت",
          "type": "radio",
          "options": [
            {
              "value": "cash",
              "label_fa": "نقدی"
            },
            {
              "value": "installment",
              "label_fa": "اقساطی"
            }
          ]
        },
        {
          "name": "installment_count",
          "label_fa": "تعداد اقساط",
          "type": "select",
          "options": [
            2,
            3,
            4
          ],
          "show_if": {"field": "payment_method", "op": "eq", "value": "installment"},
          "required_if": {"field": "payment_method", "op": "eq", "value": "installment"},
          "visible_when": "payment_method == 'installment'"
        }
      ]
    }
  ],
  "scheduled_automation": {
    "mode": "batch_start",
    "completion_role": "student",
    "triggers": [
      {
        "event": "term_registration_window",
        "source": "InstituteCalendar"
      }
    ]
  }
}
