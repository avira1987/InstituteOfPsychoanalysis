{
  "process": {
    "code": "violation_registration",
    "name_fa": "ثبت تخلفات",
    "name_en": "Violation Registration",
    "number": 55,
    "description": "ستون فقرات سیستم انضباطی. ثبت، بررسی و صدور حکم تخلفات (حرفه‌ای، آموزشی، انضباطی). ضرب‌الاجل ۳ روزه برای اقدام اولیه؛ تذکر و اخطارهای ۱ تا ۳؛ تعلیق موقت (آنی یا از ترم بعد)؛ ارجاع به کمیته آموزش و حکم اخراج. جدول گزارش عملکرد دانشجو در پورتال کمیته نظارت و دانشجو.",
    "initial_state": "violation_reported",
    "initial_role": "reporter",
    "requires_form": true
  },
  "states": [
    {
      "code": "violation_reported",
      "name_fa": "تخلف ثبت و ارجاع به کمیته نظارت",
      "type": "initial",
      "assigned_role": "monitoring_committee_officer",
      "sla_days": 3,
      "on_sla_breach_event": "first_action_sla_breach",
      "metadata": {
        "operator_task_fa": "بررسی گزارش و ثبت اقدام اولیه (قابل بررسی بودن یا نبودن) ظرف ۳ روز.",
        "operator_short_fa": "تخلف ثبت و ارجاع به کمیته نظارت"
      }
    },
    {
      "code": "review_status_set",
      "name_fa": "قابل بررسی — تعیین نوع تخلف و نیاز به جلسه",
      "type": "intermediate",
      "assigned_role": "supervision_committee",
      "metadata": {
        "operator_task_fa": "نوع تخلف و نیاز به جلسه با دانشجو را ثبت کنید؛ سپس دکمهٔ متناسب را بزنید.",
        "operator_short_fa": "تعیین نوع تخلف و جلسه"
      }
    },
    {
      "code": "meeting_scheduled",
      "name_fa": "جلسه تنظیم و دعوت‌نامه ارسال شد",
      "type": "intermediate",
      "assigned_role": "supervision_committee",
      "metadata": {
        "operator_task_fa": "پس از برگزاری جلسه، فرم حکم را تکمیل و «صدور حکم» را بزنید.",
        "operator_short_fa": "جلسه تنظیم و دعوت‌نامه ارسال شد",
        "student_short_fa": "جلسه کمیته نظارت",
        "student_task_fa": "زمان و نحوهٔ برگزاری جلسه در همین صفحه نمایش داده می‌شود؛ در روز مقرر طبق اعلام کمیته حاضر شوید."
      }
    },
    {
      "code": "verdict_issued",
      "name_fa": "حکم صادر شد (تذکر/اخطار ۱-۳)",
      "type": "intermediate",
      "assigned_role": "supervision_committee",
      "sla_days": 7,
      "on_sla_breach_event": "compensatory_followup_sla_breach",
      "metadata": {
        "operator_task_fa": "در صورت شروط جبرانی، پیگیری پس از ۷ روز را انجام دهید.",
        "operator_short_fa": "حکم صادر شد"
      }
    },
    {
      "code": "suspension_next_term",
      "name_fa": "تعلیق از ترم بعد",
      "type": "intermediate",
      "assigned_role": "supervision_committee",
      "metadata": {
        "operator_task_fa": "پیگیری شروط جبرانی یا ارجاع به کمیته آموزش.",
        "operator_short_fa": "تعلیق از ترم بعد"
      }
    },
    {
      "code": "suspension_immediate",
      "name_fa": "تعلیق آنی",
      "type": "intermediate",
      "assigned_role": "supervision_committee",
      "metadata": {
        "operator_task_fa": "پیگیری شروط جبرانی یا ارجاع به کمیته آموزش.",
        "operator_short_fa": "تعلیق آنی"
      }
    },
    {
      "code": "referred_to_education_committee",
      "name_fa": "ارجاع به کمیته آموزش",
      "type": "intermediate",
      "assigned_role": "education_committee",
      "metadata": {
        "operator_task_fa": "بررسی پرونده در جلسه آنلاین کمیته آموزش و ثبت حکم نهایی.",
        "operator_short_fa": "ارجاع به کمیته آموزش"
      }
    },
    {
      "code": "closed",
      "name_fa": "مختومه (مبرا / رد)",
      "type": "terminal",
      "assigned_role": "system"
    },
    {
      "code": "expelled",
      "name_fa": "اخراج — پورتال مسدود",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "اخراج از آموزش",
        "student_task_fa": "پورتال شما به حالت فقط‌خواندنی درآمده است. در صورت پرسش با دفتر انستیتو تماس بگیرید."
      }
    }
  ],
  "transitions": [
    {
      "from": "violation_reported",
      "to": "review_status_set",
      "trigger": "committee_reviewing",
      "required_role": "monitoring_committee_officer",
      "conditions": ["violation_reviewable_yes"],
      "description_fa": "قابل بررسی است — ارجاع به کمیته نظارت"
    },
    {
      "from": "violation_reported",
      "to": "closed",
      "trigger": "recorded_and_closed",
      "required_role": "monitoring_committee_officer",
      "conditions": ["violation_reviewable_no"],
      "description_fa": "قابل بررسی نیست — مختومه",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "violation_recorded",
          "recipients": ["student"]
        }
      ]
    },
    {
      "from": "violation_reported",
      "to": "violation_reported",
      "trigger": "first_action_sla_breach",
      "required_role": "system",
      "description_fa": "گذشت ۳ روز بدون اقدام اولیه",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "violation_first_action_sla_breach",
          "recipients": ["monitoring_committee_officer", "deputy_education"]
        }
      ]
    },
    {
      "from": "review_status_set",
      "to": "meeting_scheduled",
      "trigger": "meeting_set",
      "required_role": "supervision_committee",
      "conditions": ["violation_needs_meeting_yes"],
      "description_fa": "جلسه تنظیم شد",
      "actions": [
        {
          "type": "notification",
          "notification_type": "email",
          "template": "violation_meeting_invite",
          "recipients": ["student"]
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "violation_meeting_invite_sms",
          "recipients": ["student"]
        }
      ]
    },
    {
      "from": "review_status_set",
      "to": "verdict_issued",
      "trigger": "verdict_direct",
      "required_role": "supervision_committee",
      "conditions": ["violation_needs_meeting_no"],
      "description_fa": "بدون جلسه — حکم مستقیم",
      "actions": [
        {
          "type": "record_violation_performance_entry"
        },
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "violation_verdict_issued",
          "recipients": ["student"]
        }
      ]
    },
    {
      "from": "review_status_set",
      "to": "closed",
      "trigger": "dismissed",
      "required_role": "supervision_committee",
      "description_fa": "قابل بررسی نیست — مختومه"
    },
    {
      "from": "meeting_scheduled",
      "to": "verdict_issued",
      "trigger": "verdict_issued",
      "required_role": "supervision_committee",
      "description_fa": "حکم صادر شد پس از جلسه",
      "actions": [
        {
          "type": "record_violation_performance_entry"
        },
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "violation_verdict_issued",
          "recipients": ["student"]
        }
      ]
    },
    {
      "from": "verdict_issued",
      "to": "closed",
      "trigger": "verdict_recorded",
      "required_role": "supervision_committee",
      "conditions": ["violation_verdict_minor"],
      "description_fa": "تذکر/اخطار — پرونده مختومه",
      "actions": [
        {
          "type": "record_violation_performance_entry"
        }
      ]
    },
    {
      "from": "verdict_issued",
      "to": "suspension_next_term",
      "trigger": "suspension_next_term",
      "required_role": "supervision_committee",
      "conditions": ["violation_verdict_suspension_next_term"],
      "description_fa": "تعلیق از ترم بعد",
      "actions": [
        {
          "type": "record_violation_performance_entry"
        },
        {
          "type": "block_next_term_registration"
        },
        {
          "type": "block_attendance_registration"
        }
      ]
    },
    {
      "from": "verdict_issued",
      "to": "suspension_immediate",
      "trigger": "suspension_immediate",
      "required_role": "supervision_committee",
      "conditions": ["violation_verdict_suspension_immediate"],
      "description_fa": "تعلیق آنی",
      "actions": [
        {
          "type": "record_violation_performance_entry"
        },
        {
          "type": "suspend_class_registration"
        },
        {
          "type": "block_attendance_registration"
        }
      ]
    },
    {
      "from": "verdict_issued",
      "to": "referred_to_education_committee",
      "trigger": "referred_to_education",
      "required_role": "supervision_committee",
      "conditions": ["violation_verdict_refer_education"],
      "description_fa": "ارجاع به کمیته آموزش",
      "actions": [
        {
          "type": "record_violation_performance_entry"
        },
        {
          "type": "create_education_committee_task"
        }
      ]
    },
    {
      "from": "verdict_issued",
      "to": "verdict_issued",
      "trigger": "compensatory_followup_sla_breach",
      "required_role": "system",
      "description_fa": "یادآوری پیگیری شروط جبرانی پس از ۷ روز",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "violation_compensatory_reminder",
          "recipients": ["monitoring_committee_officer"]
        }
      ]
    },
    {
      "from": "suspension_next_term",
      "to": "closed",
      "trigger": "lift_suspension",
      "required_role": "supervision_committee",
      "conditions": ["violation_lift_suspension_yes"],
      "description_fa": "برداشتن تعلیق",
      "actions": [
        {
          "type": "lift_suspension_restrictions"
        }
      ]
    },
    {
      "from": "suspension_immediate",
      "to": "closed",
      "trigger": "lift_suspension",
      "required_role": "supervision_committee",
      "conditions": ["violation_lift_suspension_yes"],
      "description_fa": "برداشتن تعلیق آنی",
      "actions": [
        {
          "type": "lift_suspension_restrictions"
        }
      ]
    },
    {
      "from": "suspension_next_term",
      "to": "referred_to_education_committee",
      "trigger": "referred_to_education",
      "required_role": "supervision_committee",
      "description_fa": "ارجاع به کمیته آموزش از حالت تعلیق"
    },
    {
      "from": "suspension_immediate",
      "to": "referred_to_education_committee",
      "trigger": "referred_to_education",
      "required_role": "supervision_committee",
      "description_fa": "ارجاع به کمیته آموزش از حالت تعلیق آنی"
    },
    {
      "from": "referred_to_education_committee",
      "to": "expelled",
      "trigger": "expulsion_issued",
      "required_role": "education_committee",
      "conditions": ["violation_education_expulsion"],
      "description_fa": "حکم اخراج",
      "actions": [
        {
          "type": "record_violation_performance_entry"
        },
        {
          "type": "revoke_student_access"
        },
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "violation_expulsion_issued",
          "recipients": ["student", "monitoring_committee_officer"]
        }
      ]
    },
    {
      "from": "referred_to_education_committee",
      "to": "closed",
      "trigger": "closed",
      "required_role": "education_committee",
      "conditions": ["violation_education_no_expulsion"],
      "description_fa": "مختومه بدون اخراج",
      "actions": [
        {
          "type": "record_violation_performance_entry"
        }
      ]
    }
  ],
  "forms": [
    {
      "code": "violation_initial_review",
      "name_fa": "بررسی اولیه گزارش تخلف",
      "used_in_state": "violation_reported",
      "description_fa": "ظرف ۳ روز «قابل بررسی بودن» را ثبت کنید. اگر قابل بررسی نیست، «ثبت و مختومه» را بزنید؛ در غیر این صورت «در حال بررسی».",
      "visible_to": ["monitoring_committee_officer", "supervision_committee", "admin", "staff"],
