{
  "process": {
    "code": "intro_second_semester_registration",
    "name_fa": "فرایند ثبت‌نام دانشجو برای ترم دوم دوره آشنایی",
    "name_en": "Introductory Course Second Semester Registration",
    "number": 33,
    "description": "ثبت‌نام دانشجو برای ترم دوم دوره آشنایی. شامل: بررسی صلاحیت (شرط درمان و تعلیق انضباطی)، نمایش دروس مجاز بر اساس نوع پذیرش (تک‌درس: فقط تئوری روانکاوی ۲ / کامل و مشروط: تمام دروس ترم ۲)، منطق پیش‌نیاز-هم‌نیاز (درس مردودی ترم ۱ به هم‌نیاز تبدیل شده و همزمان قابل اخذ)، انتخاب روش پرداخت (نقدی یا اقساط حداکثر ۴ — تک‌درس فقط نقدی)، پرداخت، ثبت‌نام نهایی و ایجاد لینک کلاس آنلاین.",
    "initial_state": "eligibility_check"
  },
  "states": [
    {
      "code": "eligibility_check",
      "name_fa": "بررسی صلاحیت ثبت‌نام",
      "type": "initial",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "بررسی صلاحیت ثبت‌نام",
        "student_task_fa": "سامانه در حال بررسی شرط درمان و وضعیت تعلیق است؛ چند لحظه بعد همین صفحه را تازه کنید.",
        "student_why_fa": "پس از تأیید صلاحیت، انتخاب دروس ترم دوم برای شما باز می‌شود."
      }
    },
    {
      "code": "therapy_check_failed",
      "name_fa": "توقف — شرط درمان برآورده نشده",
      "type": "terminal",
      "assigned_role": "system",
      "ui_hint": "popup_message",
      "metadata": {
        "student_short_fa": "توقف — شرط درمان برآورده نشده",
        "student_task_fa": "شما درمانگر فعالی ندارید و امکان ثبت‌نام شما برای ترم دوم ممکن نیست.",
        "student_why_fa": "پذیرش مشروط به درمان بدون درمانگر فعال، ثبت‌نام ترم دوم را مجاز نمی‌کند."
      }
    },
    {
      "code": "suspension_check_failed",
      "name_fa": "توقف — دانشجو تعلیق شده",
      "type": "terminal",
      "assigned_role": "system",
      "ui_hint": "popup_message",
      "metadata": {
        "student_short_fa": "توقف — تعلیق از آموزش",
        "student_task_fa": "به دلیل تعلیق از آموزش، امکان ثبت‌نام در ترم دوم وجود ندارد؛ برای رفع تعلیق با واحد انستیتو تماس بگیرید.",
        "student_why_fa": "تا رفع تعلیق، ثبت‌نام ترم جدید از پنل برای شما باز نمی‌شود."
      }
    },
    {
      "code": "course_selection",
      "name_fa": "انتخاب دروس ترم دوم",
      "type": "intermediate",
      "assigned_role": "student",
      "metadata": {
        "student_short_fa": "انتخاب دروس ترم دوم",
        "student_task_fa": "دروس مجاز ترم دوم را در فرم همین صفحه انتخاب و تأیید کنید؛ سپس دکمهٔ ادامه را بزنید.",
        "student_why_fa": "فهرست دروس بر اساس نوع پذیرش شما (تک‌درس یا کامل) محدود شده است."
      }
    },
    {
      "code": "payment_method",
      "name_fa": "انتخاب روش پرداخت",
      "type": "intermediate",
      "assigned_role": "student",
      "metadata": {
        "student_short_fa": "انتخاب روش پرداخت",
        "student_task_fa": "روش پرداخت را در فرم همین صفحه انتخاب کنید (نقدی یا اقساط تا ۴ قسط)؛ دانشجوی تک‌درس فقط نقدی — سپس ادامه دهید.",
        "student_why_fa": "پس از انتخاب روش، به درگاه پرداخت سپ هدایت می‌شوید."
      }
    },
    {
      "code": "payment_processing",
      "name_fa": "در حال پرداخت",
      "type": "intermediate",
      "assigned_role": "student",
      "metadata": {
        "student_short_fa": "در حال پرداخت شهریه ترم دوم",
        "student_task_fa": "شهریه ترم دوم را از بخش پرداخت سپ همین صفحه بپردازید؛ پس از بازگشت از بانک، صفحه را یک‌بار تازه کنید.",
        "student_why_fa": "پس از تأیید پرداخت، ثبت‌نام نهایی و لینک کلاس برای شما فعال می‌شود."
      }
    },
    {
      "code": "registration_complete",
      "name_fa": "ثبت‌نام نهایی — دروس ثبت و لینک کلاس فعال (اقساط باز یا تسویهٔ در حال انجام)",
      "type": "intermediate",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "ثبت‌نام ترم دوم نهایی شد",
        "student_task_fa": "ثبت‌نام ترم دوم تکمیل شد؛ لینک کلاس فعال است. اگر اقساطی پرداخت کردید، اقساط بعدی را در سررسید از همین پرتال بپردازید.",
        "student_why_fa": "تا تسویهٔ کامل اقساط، در صورت معوق شدن قسط، حضور شما در کلاس بلاک می‌شود."
      }
    },
    {
      "code": "installment_overdue",
      "name_fa": "قسط معوق — بلاک حضور و غیاب",
      "type": "intermediate",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "قسط معوق — بلاک حضور و غیاب",
        "student_task_fa": "قسط معوق را از بخش پرداخت سپ همین صفحه بپردازید؛ پس از بازگشت از بانک، صفحه را تازه کنید.",
        "student_why_fa": "تا پرداخت قسط معوق، حضور شما در کلاس‌ها ثبت نمی‌شود."
      }
    },
    {
      "code": "term2_registration_closed",
      "name_fa": "پایان فرایند ثبت‌نام ترم دوم — تسویهٔ مالی تکمیل‌شده",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "تسویه مالی ترم دوم کامل شد",
        "student_task_fa": "فرایند ثبت‌نام ترم دوم بسته شد؛ دروس و لینک‌های کلاس در پنل آموزش در دسترس است.",
        "student_why_fa": "ادامهٔ مسیر آموزشی شما از طریق کلاس‌ها و جلسات آنلاین در پنل دانشجوست."
      }
    }
  ],
  "transitions": [
    {
      "from": "eligibility_check",
      "to": "therapy_check_failed",
      "trigger": "eligibility_check_result",
      "conditions": [
        "admission_type == 'conditional_therapy'",
        "no_active_therapist_registered"
      ],
      "description_fa": "دانشجو مشروط به درمان بوده اما درمانگر فعال ثبت نکرده — نمایش پیام خطا",
      "actions": [
        {
          "type": "show_popup",
          "message_fa": "شما درمانگر فعالی ندارید و امکان ثبت‌نام شما برای ترم دوم ممکن نیست."
        }
      ],
      "required_role": "system"
    },
    {
      "from": "eligibility_check",
      "to": "suspension_check_failed",
      "trigger": "eligibility_check_result",
      "conditions": [
        "student_suspended"
      ],
      "description_fa": "دانشجو تعلیق از آموزش دارد — نمایش پیام خطا",
      "actions": [
        {
          "type": "show_popup",
          "message_fa": "به دلیل تعلیق از آموزش، امکان ثبت‌نام در ترم جدید وجود ندارد."
        }
      ],
      "required_role": "system"
    },
    {
      "from": "eligibility_check",
      "to": "course_selection",
      "trigger": "eligibility_check_result",
      "conditions": [
        "eligible_for_registration"
      ],
      "description_fa": "صلاحیت تایید شد — نمایش دروس مجاز بر اساس نوع پذیرش",
      "actions": [
        {
          "type": "load_available_courses",
          "logic": {
            "single_course": {
              "allowed": [
                "تئوری روانکاوی ۲"
              ]
            },
            "full_or_conditional": {
              "allowed": "all_term_2_courses"
            },
            "failed_prerequisite_rule": "درس مردودی ترم ۱ به هم‌نیاز تبدیل شده و در لیست دروس قابل اخذ نمایش داده می‌شود"
          }
        }
      ],
      "required_role": "system"
    },
    {
      "from": "course_selection",
      "to": "payment_method",
      "trigger": "courses_confirmed",
      "required_role": "student",
      "description_fa": "دانشجو دروس ترم دوم را انتخاب و تایید کرد"
    },
    {
      "from": "payment_method",
      "to": "payment_processing",
      "trigger": "payment_method_selected",
      "required_role": "student",
      "description_fa": "روش پرداخت انتخاب شد — هدایت به درگاه پرداخت",
      "constraints": [
        "single_course_students_cash_only"
      ]
    },
    {
      "from": "payment_processing",
      "to": "registration_complete",
      "trigger": "payment_completed",
      "priority": 9,
      "conditions": [
        "term2_installment_payment"
      ],
      "description_fa": "قسط اول (اقساطی) موفق — ثبت‌نام نهایی؛ نمونه تا تسویهٔ اقساط زنده می‌ماند",
      "actions": [
        {
          "type": "register_courses_in_portal"
        },
        {
          "type": "create_lms_course_links",
          "description_fa": "ایجاد لینک‌های درس در پورتال دانشجو"
        },
        {
          "type": "record_lms_links_placed"
        },
        {
          "type": "build_class_attendance_list"
        },
        {
          "type": "create_online_class_links",
          "description_fa": "ایجاد لینک کلاس آنلاین در LMS"
        },
        {
          "type": "record_accounting",
          "kind": "tuition"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "tuition_payment_to_accounting",
          "recipients": [
            "accounting"
          ]
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "registration_confirmed_term2",
          "recipients": [
            "student"
          ]
        },
        {
          "type": "merge_instance_context",
          "mode": "initial_payment"
        },
        {
          "type": "schedule_installment_reminders",
          "condition": "payment_method == 'installment'",
          "reminder_days_before": 7,
          "description_fa": "برنامه‌ریزی یادآوری اقساط: پیامک ۷ روز قبل از سررسید هر قسط"
        }
      ],
      "required_role": "system"
    },
    {
      "from": "payment_processing",
      "to": "term2_registration_closed",
      "trigger": "payment_completed",
      "priority": 10,
      "conditions": [
        "term2_cash_payment"
      ],
      "description_fa": "پرداخت نقدی یکجا — ثبت‌نام نهایی و بستن فرایند",
      "actions": [
        {
          "type": "register_courses_in_portal"
        },
        {
          "type": "create_lms_course_links",
          "description_fa": "ایجاد لینک‌های درس در پورتال دانشجو"
        },
        {
          "type": "record_lms_links_placed"
        },
        {
          "type": "build_class_attendance_list"
        },
        {
          "type": "create_online_class_links",
          "description_fa": "ایجاد لینک کلاس آنلاین در LMS"
        },
        {
          "type": "record_accounting",
          "kind": "tuition"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "tuition_payment_to_accounting",
          "recipients": [
            "accounting"
          ]
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "registration_confirmed_term2",
          "recipients": [
            "student"
          ]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "payment_processing",
      "to": "payment_processing",
      "trigger": "payment_failed",
      "description_fa": "پرداخت ناموفق — بازگشت برای تلاش مجدد",
      "required_role": "system"
    },
    {
      "from": "registration_complete",
      "to": "installment_overdue",
      "trigger": "installment_due_date_passed",
      "conditions": [
        "installment_not_paid"
      ],
      "description_fa": "قسط معوق — بلاک ثبت حضور و غیاب",
      "actions": [
        {
          "type": "block_attendance_registration"
        },
        {
          "type": "set_installment_portal_lock"
        },
        {
          "type": "notify_instructor",
          "message_fa": "امکان ثبت حضور برای این دانشجو به دلیل عدم تسویه بدهی شهریه وجود ندارد"
        }
      ],
      "required_role": "system"
    },
    {
      "from": "installment_overdue",
      "to": "registration_complete",
      "trigger": "overdue_installment_paid",
      "description_fa": "قسط معوق پرداخت شد — رفع بلاک حضور و غیاب و به‌روزرسانی شمارندهٔ اقساط",
      "actions": [
        {
          "type": "unblock_attendance_registration"
        },
        {
          "type": "clear_installment_portal_lock"
        },
        {
          "type": "merge_instance_context",
          "mode": "installment_paid"
        }
      ],
      "required_role": "system"
    },
    {
      "from": "registration_complete",
      "to": "term2_registration_closed",
      "trigger": "finalize_term2_registration",
      "required_role": "system",
      "conditions": [
        "term2_ready_for_close"
      ],
      "description_fa": "پس از تسویهٔ آخرین قسط (یا مسیر اقساطی با شمارندهٔ صفر)، بستن نمونهٔ فرایند"
    }
  ],
  "forms": [
    {
      "code": "term2_course_selection_form",
      "name_fa": "فرم ۱: انتخاب دروس ترم دوم",
      "used_in_state": "course_selection",
      "note_fa": "دروس بر اساس نوع پذیرش فیلتر می‌شوند. دروس مردودی ترم ۱ به عنوان هم‌نیاز نمایش داده می‌شوند.",
      "fields": [
        {
          "name": "available_courses",
          "label_fa": "دروس قابل اخذ",
          "type": "checkbox_list",
          "source": "filtered_courses_by_admission_type_and_prerequisites",
          "format": "{course_name} ({units} واحد) {prerequisite_status}",
          "prerequisite_display": {
            "passed": "پیش‌نیاز: پاس شده ✓",
            "failed_corequisite": "هم‌نیاز: مردودی ترم قبل — قابل اخذ همزمان",
            "none": ""
          },
          "required": true
        }
      ],
      "submit_label_fa": "تایید دروس و ادامه به پرداخت"
    },
    {
      "code": "term2_payment_form",
      "name_fa": "فرم ۲: انتخاب روش پرداخت ترم دوم",
      "used_in_state": "payment_method",
      "fields": [
        {
          "name": "payment_method",
          "label_fa": "روش پرداخت",
          "type": "radio",
          "options": [
            {
              "value": "cash",
              "label_fa": "پرداخت نقدی (یکجا)"
            },
            {
              "value": "installment",
              "label_fa": "پرداخت اقساطی"
            }
          ],
          "required": true,
          "note_fa": "دانشجویان تک‌درس فقط مجاز به پرداخت نقدی هستند",
          "restricted_when": {
            "admission_type": "single_course",
            "allowed_values": [
              "cash"
            ]
          }
        },
        {
          "name": "installment_count",
          "label_fa": "تعداد اقساط",
          "type": "select",
          "options": [
            {
              "value": 1,
              "label_fa": "۱ قسط (پرداخت یکجا)"
            },
            {
              "value": 2,
              "label_fa": "۲ قسط"
            },
            {
              "value": 3,
              "label_fa": "۳ قسط"
            },
            {
              "value": 4,
              "label_fa": "۴ قسط"
            }
          ],
          "show_if": {"field": "payment_method", "op": "eq", "value": "installment"},
          "required_if": {"field": "payment_method", "op": "eq", "value": "installment"},
          "visible_when": "payment_method == 'installment'",
          "required_when": "payment_method == 'installment'"
        },
        {
          "name": "discount_code",
          "label_fa": "کد تخفیف",
          "type": "text",
          "required": false,
          "placeholder_fa": "در صورت داشتن کد تخفیف وارد کنید"
        }
      ],
      "installment_schedule": {
        "installment_1": "هنگام ثبت‌نام",
        "installment_2": "۲۵ روز پس از شروع کلاس‌ها",
        "subsequent": "هر ۲۵ روز پس از قسط قبلی",
        "reminder": "۱ هفته قبل از سررسید هر قسط — پیامک یادآوری"
      },
      "installment_schedule_table": {
        "label_fa": "جدول زمان‌بندی اقساط",
        "columns": [
          {
            "name": "installment_number",
            "label_fa": "شماره قسط"
          },
          {
            "name": "due_date",
            "label_fa": "تاریخ سررسید"
          },
          {
            "name": "amount",
            "label_fa": "مبلغ (ریال)"
          }
        ]
      },
      "submit_label_fa": "پرداخت"
    }
  ],
  "scheduled_automation": {
    "mode": "reminder_queue",
    "completion_role": "student",
    "context_required": [
      "next_installment_due_at",
      "pending_installments_remaining"
    ],
    "triggers": [
      {
        "event": "installment_due_date_passed",
        "when": {
          "state": "registration_complete",
          "context_field": "next_installment_due_at",
          "op": "lte_today"
        },
        "actor_role": "system"
      }
    ]
  }
}
