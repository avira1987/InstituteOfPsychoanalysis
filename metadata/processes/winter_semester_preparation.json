{
  "process": {
    "code": "winter_semester_preparation",
    "name_fa": "فرایند آماده‌سازی ترم زمستان",
    "name_en": "Winter Semester Preparation",
    "number": 30,
    "description": "نسخه سبک‌تر فرایند ترم پاییز — بازبینی و به‌روزرسانی برنامه‌ها برای ترم زمستان. شامل بررسی پروانه، ویرایش لیست دروس، نهایی‌سازی، بازاریابی، تعیین مصاحبه‌کنندگان و زمان‌بندی مصاحبه‌ها. مهلت‌ها فقط هشدار مدیریتی ایجاد می‌کنند و سیستم را قفل نمی‌کنند.",
    "initial_state": "license_check",
    "sla_policy": "deadline_expiry_warning_only",
    "based_on": "fall_semester_preparation"
  },
  "states": [
    {
      "code": "license_check",
      "name_fa": "بررسی وضعیت پروانه فعالیت",
      "type": "initial",
      "assigned_role": "deputy_education_director",
      "sla_days": 3,
      "sla_warning_recipients": [
        "education_director"
      ],
      "metadata": {
        "operator_task_fa": "بررسی پرونده و ثبت تصمیم مدیریتی.",
        "operator_short_fa": "بررسی وضعیت پروانه فعالیت"
      }
    },
    {
      "code": "course_list_review",
      "name_fa": "بازبینی و ویرایش لیست دروس ترم زمستان",
      "type": "intermediate",
      "assigned_role": "scientific_officer_course_committee",
      "sla_days": 4,
      "sla_warning_recipients": [
        "deputy_education_director"
      ],
      "metadata": {
        "operator_task_fa": "بررسی علمی و ثبت نظر.",
        "operator_short_fa": "بازبینی و ویرایش لیست دروس ترم زمستان"
      }
    },
    {
      "code": "course_finalization",
      "name_fa": "نهایی‌سازی مکان‌ها و تایید مدرسین",
      "type": "intermediate",
      "assigned_role": "scientific_officer_course_committee",
      "sla_days": 5,
      "sla_warning_recipients": [
        "deputy_education_director"
      ],
      "metadata": {
        "operator_task_fa": "بررسی علمی و ثبت نظر.",
        "operator_short_fa": "نهایی‌سازی مکان‌ها و تایید مدرسین"
      }
    },
    {
      "code": "marketing_campaign",
      "name_fa": "شروع کمپین بازاریابی زمستان",
      "type": "intermediate",
      "assigned_role": "admissions_officer",
      "sla_days": 2,
      "sla_warning_recipients": [
        "deputy_education_director"
      ],
      "metadata": {
        "operator_task_fa": "بررسی مدارک/پرونده؛ تأیید، نقص، یا ادامه.",
        "operator_short_fa": "شروع کمپین بازاریابی زمستان"
      }
    },
    {
      "code": "interviewer_assignment",
      "name_fa": "تعیین مصاحبه‌کنندگان زمستان",
      "type": "intermediate",
      "assigned_role": "deputy_education_director",
      "sla_days": 3,
      "sla_warning_recipients": [
        "education_director"
      ],
      "metadata": {
        "operator_task_fa": "بررسی پرونده و ثبت تصمیم مدیریتی.",
        "operator_short_fa": "تعیین مصاحبه‌کنندگان زمستان"
      }
    },
    {
      "code": "interview_scheduling",
      "name_fa": "زمان‌بندی و ثبت اسلات‌های مصاحبه",
      "type": "intermediate",
      "assigned_role": "staff",
      "sla_days": 3,
      "sla_warning_recipients": [
        "deputy_education_director"
      ],
      "editable_anytime": true,
      "metadata": {
        "operator_task_fa": "نوع برگزاری را مشخص کنید، اسلات‌های قابل رزرو را ثبت کنید و فرم را ذخیره کنید.",
        "operator_short_fa": "زمان‌بندی و ثبت اسلات‌های مصاحبه"
      }
    },
    {
      "code": "published",
      "name_fa": "انتشار تقویم زمستان و اطلاع‌رسانی",
      "type": "terminal",
      "assigned_role": "system"
    }
  ],
  "transitions": [
    {
      "from": "license_check",
      "to": "course_list_review",
      "trigger": "license_reviewed",
      "required_role": "deputy_education_director",
      "description_fa": "وضعیت پروانه فعالیت بررسی شد",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "winter_license_reviewed_review_courses",
          "recipients": [
            "scientific_officer_course_committee"
          ]
        }
      ]
    },
    {
      "from": "license_check",
      "to": "license_check",
      "trigger": "sla_expired",
      "description_fa": "مهلت بررسی پروانه گذشت — هشدار به مدیر آموزش",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "sla_warning_winter_license_delay",
          "recipients": [
            "education_director"
          ]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "course_list_review",
      "to": "course_finalization",
      "trigger": "course_list_reviewed",
      "required_role": "scientific_officer_course_committee",
      "description_fa": "لیست دروس زمستان بازبینی و ویرایش شد"
    },
    {
      "from": "course_list_review",
      "to": "course_list_review",
      "trigger": "sla_expired",
      "description_fa": "مهلت بازبینی لیست دروس گذشت — هشدار به معاون",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "sla_warning_winter_course_review_delay",
          "recipients": [
            "deputy_education_director"
          ]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "course_finalization",
      "to": "marketing_campaign",
      "trigger": "courses_finalized",
      "required_role": "scientific_officer_course_committee",
      "description_fa": "مکان‌ها و تایید مدرسین نهایی شد",
      "actions": [
        {
          "type": "publish_term_course_offerings"
        },
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "winter_courses_finalized_start_marketing",
          "recipients": [
            "admissions_officer"
          ]
        }
      ]
    },
    {
      "from": "course_finalization",
      "to": "course_finalization",
      "trigger": "sla_expired",
      "description_fa": "مهلت نهایی‌سازی زمستان گذشت — هشدار به معاون",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "sla_warning_winter_finalization_delay",
          "recipients": [
            "deputy_education_director"
          ]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "marketing_campaign",
      "to": "interviewer_assignment",
      "trigger": "marketing_started",
      "required_role": "admissions_officer",
      "description_fa": "کمپین بازاریابی زمستان آغاز شد",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "winter_marketing_started_set_interviewers",
          "recipients": [
            "deputy_education_director"
          ]
        }
      ]
    },
    {
      "from": "marketing_campaign",
      "to": "marketing_campaign",
      "trigger": "sla_expired",
      "description_fa": "مهلت شروع بازاریابی زمستان گذشت — هشدار به معاون",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "sla_warning_winter_marketing_delay",
          "recipients": [
            "deputy_education_director"
          ]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "interviewer_assignment",
      "to": "interview_scheduling",
      "trigger": "interviewers_assigned",
      "required_role": "deputy_education_director",
      "description_fa": "مصاحبه‌کنندگان زمستان تعیین شدند",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "winter_interviewers_set_schedule_times",
          "recipients": [
            "staff"
          ]
        }
      ]
    },
    {
      "from": "interviewer_assignment",
      "to": "interviewer_assignment",
      "trigger": "sla_expired",
      "description_fa": "مهلت تعیین مصاحبه‌کنندگان زمستان گذشت — هشدار به مدیر آموزش",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "sla_warning_winter_interviewer_delay",
          "recipients": [
            "education_director"
          ]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "interview_scheduling",
      "to": "published",
      "trigger": "interview_times_set",
      "required_role": "staff",
      "description_fa": "زمان‌بندی مصاحبه‌های زمستان ثبت شد — انتشار و اطلاع‌رسانی",
      "actions": [
        {
          "type": "publish_academic_calendar_to_profiles"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "winter_calendar_published",
          "recipients": [
            "all_active_fall_students"
          ]
        },
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "winter_calendar_published",
          "recipients": [
            "all_active_fall_students",
            "all_instructors"
          ]
        }
      ]
    },
    {
      "from": "interview_scheduling",
      "to": "interview_scheduling",
      "trigger": "sla_expired",
      "description_fa": "مهلت زمان‌بندی مصاحبه‌های زمستان گذشت — هشدار به معاون",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "sla_warning_winter_interview_scheduling_delay",
          "recipients": [
            "deputy_education_director"
          ]
        }
      ],
      "required_role": "system"
    }
  ],
  "forms": [
    {
      "code": "winter_license_check_form",
      "name_fa": "فرم بررسی پروانه فعالیت (زمستان)",
      "used_in_state": "license_check",
      "editable_by": ["admin", "staff", "deputy_education", "deputy_education_director"],
      "fields": [
        {
          "name": "license_status",
          "label_fa": "وضعیت پروانه",
          "type": "radio",
          "options": [
            "بدون تغییر",
            "تغییر کرده"
          ],
          "required": true
        },
        {
          "name": "new_license_number",
          "label_fa": "شماره پروانه جدید",
          "type": "text",
          "required": false,
          "visible_if": {
            "license_status": "تغییر کرده"
          }
        },
        {
          "name": "license_notes",
          "label_fa": "توضیحات",
          "type": "textarea",
          "required": false
        }
      ]
    },
    {
      "code": "winter_course_list_review_form",
      "name_fa": "فرم بازبینی لیست دروس زمستان",
      "used_in_state": "course_list_review",
      "editable_by": ["admin", "staff", "course_committee", "course_committee_scientific", "scientific_officer_course_committee"],
      "note": "فرم از داده‌های ترم پاییز پر شده و قابل ویرایش است",
      "fields": [
        {
          "name": "courses",
          "label_fa": "جدول دروس زمستان",
          "type": "table",
          "required": true,
          "pre_filled_from": "fall_semester_preparation.courses_winter",
          "columns": [
            {
              "name": "course_name",
              "label_fa": "نام درس",
              "type": "creatable_select",
              "creatable": true,
              "searchable": true,
              "options_source": {
                "type": "course_catalog"
              }
            },
            {
              "name": "track",
              "label_fa": "رسته",
              "type": "creatable_select",
              "creatable": true,
              "searchable": true,
              "auto_fill_from": "course_name",
              "options_source": {
                "type": "course_committee_tracks"
              }
            },
            {
              "name": "proposed_day",
              "label_fa": "روز پیشنهادی",
              "type": "select",
              "options": [
                "شنبه",
                "یکشنبه",
                "دوشنبه",
                "سه‌شنبه",
                "چهارشنبه",
                "پنجشنبه",
                "جمعه"
              ]
            },
            {
              "name": "proposed_time",
              "label_fa": "ساعت پیشنهادی",
              "type": "time"
            },
            {
              "name": "instructor",
              "label_fa": "مدرس",
              "type": "creatable_select",
              "creatable": true,
              "searchable": true,
              "options_source": {
                "type": "course_committee_roster",
                "kind": "instructor",
                "filter_by_column": "track"
              }
            },
            {
              "name": "teaching_assistant",
              "label_fa": "دستیار آموزشی",
              "type": "creatable_select",
              "creatable": true,
              "searchable": true,
              "options_source": {
                "type": "course_committee_roster",
                "kind": "teaching_assistant",
                "filter_by_column": "track"
              }
            }
          ]
        }
      ]
    },
    {
      "code": "winter_course_finalization_form",
      "name_fa": "فرم نهایی‌سازی دروس زمستان",
      "used_in_state": "course_finalization",
      "editable_by": ["admin", "staff", "course_committee", "course_committee_scientific", "scientific_officer_course_committee"],
      "fields": [
        {
          "name": "courses_finalized",
          "label_fa": "جدول نهایی دروس زمستان",
          "type": "table",
          "required": true,
          "columns": [
            {
              "name": "course_name",
              "label_fa": "نام درس",
              "type": "text",
              "auto_fill": true
            },
            {
              "name": "day",
              "label_fa": "روز",
              "type": "text",
              "auto_fill": true
            },
            {
              "name": "time",
              "label_fa": "ساعت",
              "type": "time",
              "auto_fill": true
            },
            {
              "name": "instructor",
              "label_fa": "مدرس",
              "type": "text",
              "auto_fill": true
            },
            {
              "name": "classroom_location",
              "label_fa": "مکان کلاس",
              "type": "text"
            },
            {
              "name": "instructor_coordinated",
              "label_fa": "هماهنگی با مدرس انجام شد",
              "type": "checkbox"
            }
          ]
        }
      ]
    },
    {
      "code": "winter_marketing_campaign_form",
      "name_fa": "فرم تأیید شروع کمپین بازاریابی زمستان",
      "used_in_state": "marketing_campaign",
      "editable_by": ["admin", "staff", "admissions_officer"],
      "note_fa": "خروجی فعالیت‌های ۲ (لیست دروس) و ۳ (برنامه نهایی) را به‌صورت PDF بگیرید و برای مدیر مارکتینگ ارسال کنید.",
      "fields": [
        {
          "name": "marketing_info_sent_to_manager",
          "label_fa": "اطلاعات لازم برای شروع کمپین تبلیغاتی زمستان (خروجی فعالیت‌های ۲ و ۳) برای مدیر مارکتینگ ارسال شد",
          "type": "checkbox",
          "required": true
        },
        {
          "name": "marketing_notes",
          "label_fa": "یادداشت انتقال به مدیر مارکتینگ (اختیاری)",
          "type": "textarea",
          "required": false
        }
      ]
    },
    {
      "code": "winter_interviewer_assignment_form",
      "name_fa": "فرم تعیین مصاحبه‌کنندگان زمستان",
      "used_in_state": "interviewer_assignment",
      "visible_to": ["admin", "deputy_education", "deputy_education_director"],
      "editable_by": ["admin", "deputy_education", "deputy_education_director"],
      "fields": [
        {
          "name": "comprehensive_interviewers",
          "label_fa": "مصاحبه‌کنندگان دوره جامع",
          "type": "multi_select",
          "required": true,
          "creatable": false,
          "note_fa": "از میان کارمندان اتوماسیون انتخاب کنید.",
          "options_source": {
            "type": "users",
            "roles": ["interviewer", "staff"],
            "is_active": true
          }
        },
        {
          "name": "comprehensive_date_range_start",
          "label_fa": "شروع بازه مصاحبه دوره جامع",
          "type": "date",
          "required": true
        },
        {
          "name": "comprehensive_date_range_end",
          "label_fa": "پایان بازه مصاحبه دوره جامع",
          "type": "date",
          "required": true
        },
        {
          "name": "introductory_interviewers",
          "label_fa": "مصاحبه‌کنندگان دوره آشنایی",
          "type": "multi_select",
          "required": true,
          "creatable": false,
          "note_fa": "از میان کارمندان اتوماسیون انتخاب کنید.",
          "options_source": {
            "type": "users",
            "roles": ["interviewer", "staff"],
            "is_active": true
          }
        },
        {
          "name": "introductory_date_range_start",
          "label_fa": "شروع بازه مصاحبه دوره آشنایی",
          "type": "date",
          "required": true
        },
        {
          "name": "introductory_date_range_end",
          "label_fa": "پایان بازه مصاحبه دوره آشنایی",
          "type": "date",
          "required": true
        }
      ]
    },
    {
      "code": "winter_interview_scheduling_form",
      "name_fa": "تنظیمات برگزاری مصاحبه",
      "used_in_state": "interview_scheduling",
      "editable_by": ["admin", "staff", "deputy_education"],
      "editable_anytime": true,
      "note_fa": "برای مصاحبهٔ آنلاین، لینک جلسه پس از پرداخت هزینهٔ مصاحبه توسط دانشجو به‌صورت خودکار ساخته می‌شود و دکمهٔ «ورود به جلسه» در پروفایل دانشجو و مصاحبه‌گر نمایش داده می‌شود.",
      "fields": [
        {
          "name": "interview_mode",
          "label_fa": "نوع مصاحبه",
          "type": "select",
          "options": [
            "حضوری",
            "آنلاین"
          ],
          "required": true
        },
        {
          "name": "interview_location_fa",
          "label_fa": "آدرس یا محل برگزاری (حضوری)",
          "type": "textarea",
          "required": true,
          "visible_if": {
            "interview_mode": "حضوری"
          }
        }
      ]
    }
  ],
  "scheduled_automation": {
    "mode": "instance_sla",
    "completion_role": "staff",
    "triggers": [
      {
        "event": "sla_expired",
        "actor_role": "system"
      }
    ]
  }
}
