{
  "process": {
    "code": "supervision_session_increase",
    "name_fa": "درخواست دانشجو برای افزایش جلسات هفتگی سوپرویژن",
    "name_en": "Student Request for Increasing Weekly Supervision Sessions",
    "description": "مختص دوره جامع. دانشجو روز و ساعت جلسه سوپرویژن جدید را درخواست می‌کند. سوپروایزر: تایید / رد+پیشنهاد جایگزین (مذاکره) / رد کامل. جلسه اضافه مشمول فرایند تکمیل دوره‌های ۵۰ ساعته.",
    "initial_state": "request_submitted",
    "eligibility": "فقط دوره جامع. سایر دانشجویان دسترسی ندارند."
  },
  "states": [
    {
      "code": "request_submitted",
      "name_fa": "ثبت درخواست افزایش جلسه سوپرویژن",
      "type": "initial",
      "assigned_role": "student",
      "metadata": {
        "student_short_fa": "درخواست افزایش جلسهٔ هفتگی سوپرویژن",
        "student_task_fa": "تاریخ نزدیک‌ترین جلسه و ساعت شروع جلسهٔ سوپرویژن جدید را وارد کنید؛ فرم را ثبت کنید؛ سپس «ادامه و ثبت مرحله» را بزنید تا سوپروایزر بررسی کند. پس از تأیید، یک جلسهٔ هفتگی دیگر به برنامهٔ شما اضافه می‌شود."
      }
    },
    {
      "code": "supervisor_review",
      "name_fa": "بررسی و تصمیم سوپروایزر",
      "type": "intermediate",
      "assigned_role": "supervisor",
      "sla_hours": 48,
      "metadata": {
        "student_short_fa": "منتظر تصمیم سوپروایزر",
        "student_task_fa": "سوپروایزر در حال بررسی زمان پیشنهادی شماست؛ پس از اعلام نتیجه همین صفحه را تازه کنید. در صورت پیشنهاد زمان جدید، اطلاع‌رسانی می‌شود.",
        "operator_task_fa": "زمان پیشنهادی دانشجو را بررسی کنید؛ در صورت «پیشنهاد جایگزین» تاریخ و ساعت جایگزین را وارد و دکمهٔ تصمیم را بزنید.",
        "operator_short_fa": "بررسی و تصمیم سوپروایزر"
      }
    },
    {
      "code": "student_response",
      "name_fa": "پاسخ دانشجو به پیشنهاد جایگزین",
      "type": "intermediate",
      "assigned_role": "student",
      "sla_hours": 72,
      "metadata": {
        "student_short_fa": "تأیید یا اصلاح زمان",
        "student_task_fa": "اگر با زمان پیشنهادی سوپروایزر موافقید، دکمهٔ تأیید را بزنید. اگر زمان دیگری می‌خواهید، تاریخ و ساعت جدید را در فرم بنویسید و دکمهٔ «ورود زمان جدید» را بزنید."
      }
    },
    {
      "code": "session_added",
      "name_fa": "جلسه هفتگی سوپرویژن اضافه شد",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "تکمیل شد",
        "student_task_fa": "جلسهٔ هفتگی سوپرویژن جدید به برنامهٔ شما اضافه شد و مشمول فرایند تکمیل دوره‌های ۵۰ ساعتهٔ سوپرویژن است."
      }
    },
    {
      "code": "request_rejected",
      "name_fa": "امکان افزایش جلسه وجود ندارد",
      "type": "terminal",
      "assigned_role": "system",
      "metadata": {
        "student_short_fa": "پایان درخواست",
        "student_task_fa": "سوپروایزر در حال حاضر امکان افزایش جلسات هفتگی سوپرویژن را اعلام نکرده است؛ در صورت نیاز بعداً می‌توانید دوباره درخواست دهید."
      }
    }
  ],
  "forms": [
    {
      "title_fa": "زمان جلسهٔ هفتگی سوپرویژن اضافه",
      "used_in_state": "request_submitted",
      "editable_by": ["admin", "supervisor"],
      "fields": [
        {
          "name": "first_session_date",
          "label_fa": "تاریخ نزدیک‌ترین جلسه (میلادی YYYY-MM-DD)",
          "type": "text",
          "required": true
        },
        {
          "name": "preferred_time_hhmm",
          "label_fa": "ساعت شروع (مثال 14:30)",
          "type": "text",
          "required": true
        },
        {
          "name": "preferred_weekday_fa",
          "label_fa": "روز هفته (اختیاری)",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "title_fa": "پاسخ به پیشنهاد سوپروایزر",
      "used_in_state": "student_response",
      "editable_by": ["admin"],
      "fields": [
        {
          "name": "student_response_note",
          "label_fa": "توضیح کوتاه (اختیاری)",
          "type": "textarea",
          "required": false
        },
        {
          "name": "new_first_session_date",
          "label_fa": "اگر زمان دیگری می‌خواهید — تاریخ (YYYY-MM-DD)",
          "type": "text",
          "required": false
        },
        {
          "name": "new_preferred_time_hhmm",
          "label_fa": "اگر زمان دیگری می‌خواهید — ساعت (مثال 15:00)",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "title_fa": "جزئیات تصمیم سوپروایزر (در صورت پیشنهاد جایگزین)",
      "used_in_state": "supervisor_review",
      "visible_to": [
        "supervisor",
        "admin"
      ],
      "editable_by": ["supervisor", "admin"],
      "fields": [
        {
          "name": "supervisor_alternative_date",
          "label_fa": "تاریخ پیشنهادی جایگزین (YYYY-MM-DD) — فقط هنگام «پیشنهاد جایگزین»",
          "type": "text",
          "required": false
        },
        {
          "name": "supervisor_alternative_time_hhmm",
          "label_fa": "ساعت پیشنهادی جایگزین (مثال 10:00)",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "transitions": [
    {
      "from": "request_submitted",
      "to": "supervisor_review",
      "trigger": "day_time_entered",
      "required_role": "student",
      "conditions": [
        "comprehensive_course_only"
      ],
      "description_fa": "دانشجو روز و ساعت جلسه سوپرویژن جدید را وارد کرد",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "supervision_session_increase_request",
          "recipients": [
            "supervisor"
          ]
        }
      ]
    },
    {
      "from": "supervisor_review",
      "to": "session_added",
      "trigger": "supervisor_approved",
      "required_role": "supervisor",
      "description_fa": "سوپروایزر زمان پیشنهادی را تایید کرد",
      "actions": [
        {
          "type": "add_recurring_supervision_session"
        },
        {
          "type": "connect_to_supervision_50h_completion"
        },
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "supervision_session_increase_approved",
          "recipients": [
            "student"
          ]
        }
      ]
    },
    {
      "from": "supervisor_review",
      "to": "student_response",
      "trigger": "supervisor_proposed_alternative",
      "required_role": "supervisor",
      "description_fa": "سوپروایزر زمان را رد و پیشنهاد جایگزین داد",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "supervision_session_increase_alternative",
          "recipients": [
            "student"
          ]
        }
      ]
    },
    {
      "from": "supervisor_review",
      "to": "request_rejected",
      "trigger": "supervisor_rejected",
      "required_role": "supervisor",
      "description_fa": "سوپروایزر امکان افزایش جلسه را ندارد",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "supervision_session_increase_rejected",
          "recipients": [
            "student"
          ]
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "supervision_session_increase_rejected",
          "recipients": [
            "student"
          ]
        }
      ]
    },
    {
      "from": "student_response",
      "to": "session_added",
      "trigger": "student_confirmed_proposal",
      "required_role": "student",
      "description_fa": "دانشجو پیشنهاد سوپروایزر را تایید کرد",
      "actions": [
        {
          "type": "add_recurring_supervision_session"
        },
        {
          "type": "connect_to_supervision_50h_completion"
        },
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "supervision_session_increase_approved",
          "recipients": [
            "student"
          ]
        }
      ]
    },
    {
      "from": "student_response",
      "to": "supervisor_review",
      "trigger": "student_reentered_time",
      "required_role": "student",
      "description_fa": "دانشجو روز و ساعت دیگری وارد کرد — بازگشت به سوپروایزر",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "supervision_session_increase_request",
          "recipients": [
            "supervisor"
          ]
        }
      ]
    }
  ]
}
