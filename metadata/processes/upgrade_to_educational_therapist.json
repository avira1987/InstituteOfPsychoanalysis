      "description_fa": "عدم تحقق شروط ارتقا — پیغام رد",
      "required_role": "student",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "et_eligibility_failed",
          "recipients": ["student"]
        }
      ]
    },
    {
      "from": "student_start",
      "to": "monitoring_review",
      "trigger": "conditions_met",
      "conditions": ["et_upgrade_eligibility_met"],
      "description_fa": "شروط اولیه — ارسال به کمیته نظارت",
      "required_role": "student"
    },
    {
      "from": "monitoring_review",
      "to": "monitoring_rejected",
      "trigger": "rejected",
      "required_role": "supervision_committee",
      "description_fa": "رد صلاحیت",
