        {
          "type": "notification",
          "notification_type": "sms",
          "template": "et_monitoring_rejected",
          "recipients": ["student"]
        }
      ]
    },
    {
      "from": "monitoring_review",
      "to": "interview_scheduling",
      "trigger": "approved",
      "required_role": "supervision_committee",
