      ]
    },
    {
      "from": "therapist_selection",
      "to": "therapist_committee_review",
      "trigger": "therapist_submitted",
      "required_role": "student",
      "description_fa": "درمانگر پیشنهادی ثبت شد"
    },
    {
      "from": "therapist_committee_review",
      "to": "therapist_selection",
      "trigger": "rejected",
      "required_role": "education_committee",
      "description_fa": "رد درمانگر — انتخاب مجدد",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "et_therapist_rejected",
          "recipients": ["student"]
        }
      ]
    },
    {
      "from": "therapist_committee_review",
      "to": "supervision_readiness_check",
      "trigger": "approved",
      "required_role": "education_committee",
      "description_fa": "تایید درمانگر — بررسی سوپرویژن",
      "actions": [
        {
          "type": "evaluate_et_supervision_readiness"
        }
      ]
    },
    {
      "from": "supervision_readiness_check",
      "to": "supervision_frequency_adjustment",
      "trigger": "frequency_increase_needed",
      "conditions": ["et_supervision_frequency_one_per_month"],
      "required_role": "system",
      "description_fa": "یک جلسه در ماه — افزایش به دو جلسه"
    },
    {
      "from": "supervision_readiness_check",
      "to": "supervision_hours",
      "trigger": "supervision_active",
      "conditions": ["et_supervision_active_two_per_month"],
      "required_role": "system",
      "description_fa": "سوپرویژن فعال — پیگیری ۵۰ ساعت"
    },
    {
      "from": "supervision_readiness_check",
      "to": "supervision_restart",
      "trigger": "supervision_restart_needed",
      "conditions": ["et_supervision_frequency_below_monthly"],
      "required_role": "system",
      "description_fa": "فرکانس کمتر از یک جلسه در ماه — آغاز مجدد"
    },
    {
      "from": "supervision_frequency_adjustment",
      "to": "supervision_hours",
      "trigger": "frequency_confirmed",
      "required_role": "student",
      "description_fa": "فرکانس ماهانه تأیید شد"
    },
    {
      "from": "supervision_restart",
      "to": "supervisor_selection",
      "trigger": "restart_confirmed",
      "required_role": "student",
      "description_fa": "آغاز مجدد سوپرویژن تأیید شد"
    },
    {
      "from": "supervision_hours",
      "to": "supervisor_selection",
      "trigger": "hours_complete",
      "conditions": ["et_supervision_hours_complete"],
      "required_role": "student",
      "description_fa": "۵۰ ساعت سوپرویژن تکمیل شد"
    },
    {
      "from": "supervisor_selection",
      "to": "et_availability_slots",
      "trigger": "supervisor_selected",
      "required_role": "student",
      "description_fa": "سوپروایزر و زمان انتخاب شد"
    },
    {
      "from": "et_availability_slots",
      "to": "promotion_completed",
      "trigger": "slots_registered",
      "required_role": "student",
      "description_fa": "ثبت دو زمان خالی — پایان فرایند",
