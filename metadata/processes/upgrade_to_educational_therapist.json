        {
          "type": "notification",
          "notification_type": "sms",
          "template": "et_interview_scheduled",
          "recipients": ["student", "education_committee"]
        }
      ]
    },
    {
      "from": "interview_held",
      "to": "interview_rejected",
      "trigger": "interview_rejected",
      "required_role": "education_committee",
      "description_fa": "رد پس از مصاحبه",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "et_interview_rejected",
          "recipients": ["student"]
        }
      ]
    },
    {
      "from": "interview_held",
      "to": "therapy_readiness_check",
