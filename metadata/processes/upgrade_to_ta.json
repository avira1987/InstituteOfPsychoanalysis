{
  "process": {
    "code": "upgrade_to_ta",
    "name_fa": "ارتقا به کمک‌مدرس",
    "name_en": "Upgrade to Teaching Assistant",
    "number": 47,
    "description": "شرط: معدل B، ۵۰ ساعت درمان آموزشی، شروع انترنی. کلیک دانشجو. بررسی خودکار ۴ شرط. کمیته نظارت تایید/رد. کمیته دروس: تنظیم وقت مصاحبه، مصاحبه، تعیین رسته. تعهدنامه با OTP. اضافه به لیست کمک‌مدرسین.",
    "initial_state": "student_click",
    "initial_role": "student"
  },
  "states": [
    {
      "code": "student_click",
      "name_fa": "کلیک دانشجو",
      "type": "initial",
      "assigned_role": "student"
    },
    {
      "code": "conditions_not_met",
      "name_fa": "شرایط احراز نشد",
      "type": "terminal",
      "assigned_role": "system"
    },
    {
      "code": "supervision_review",
      "name_fa": "بررسی کمیته نظارت",
      "type": "intermediate",
      "assigned_role": "supervision_committee",
      "metadata": {
        "operator_task_fa": "بررسی/صدور مجوز طبق دستور کار.",
        "operator_short_fa": "بررسی کمیته نظارت"
      }
    },
    {
      "code": "supervision_rejected",
      "name_fa": "رد توسط کمیته نظارت",
      "type": "terminal",
      "assigned_role": "system"
    },
    {
      "code": "interview_scheduling",
      "name_fa": "تنظیم وقت مصاحبه",
      "type": "intermediate",
      "assigned_role": "course_committee",
      "metadata": {
        "operator_task_fa": "بررسی موضوع در کمیته دروس.",
        "operator_short_fa": "تنظیم وقت مصاحبه"
      }
    },
    {
      "code": "interview_held",
      "name_fa": "مصاحبه برگزار شد",
      "type": "intermediate",
      "assigned_role": "course_committee",
      "metadata": {
        "operator_task_fa": "بررسی موضوع در کمیته دروس.",
        "operator_short_fa": "مصاحبه برگزار شد"
      }
    },
    {
      "code": "course_committee_rejected",
      "name_fa": "رد توسط کمیته دروس",
      "type": "terminal",
      "assigned_role": "system"
    },
    {
      "code": "track_selection",
      "name_fa": "انتخاب رسته‌های توافق شده",
      "type": "intermediate",
      "assigned_role": "course_committee",
      "metadata": {
        "operator_task_fa": "بررسی موضوع در کمیته دروس.",
        "operator_short_fa": "انتخاب رسته‌های توافق شده"
      }
    },
    {
      "code": "commitment_signature",
      "name_fa": "امضای تعهدنامه",
      "type": "intermediate",
      "assigned_role": "student"
    },
    {
      "code": "ta_registered",
      "name_fa": "کمک‌مدرس ثبت شد",
      "type": "terminal",
      "assigned_role": "system"
    }
  ],
  "transitions": [
    {
      "from": "student_click",
      "to": "conditions_not_met",
      "trigger": "conditions_failed",
      "description_fa": "بررسی خودکار: معدل، ۵۰ ساعت درمان، انترنی — عدم احراز",
      "required_role": "student"
    },
    {
      "from": "student_click",
      "to": "supervision_review",
      "trigger": "conditions_met",
      "description_fa": "درخواست به کمیته نظارت ارسال شد",
      "required_role": "student"
    },
    {
      "from": "supervision_review",
      "to": "supervision_rejected",
      "trigger": "rejected",
      "required_role": "supervision_committee",
      "description_fa": "رد صلاحیت"
    },
    {
      "from": "supervision_review",
      "to": "interview_scheduling",
      "trigger": "approved",
      "required_role": "supervision_committee",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "ta_eligibility_approved",
          "recipients": [
            "student"
          ]
        }
      ]
    },
    {
      "from": "interview_scheduling",
      "to": "interview_held",
      "trigger": "interview_scheduled",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "ta_interview_scheduled",
          "recipients": [
            "student",
            "course_committee_scientific",
            "course_committee_project"
          ]
        }
      ],
      "required_role": "course_committee"
    },
    {
      "from": "interview_held",
      "to": "course_committee_rejected",
      "trigger": "rejected",
      "required_role": "course_committee",
      "description_fa": "رد صلاحیت توسط کمیته دروس"
    },
    {
      "from": "interview_held",
      "to": "track_selection",
      "trigger": "approved",
      "required_role": "course_committee",
      "description_fa": "تایید — تعیین رسته"
    },
    {
      "from": "track_selection",
      "to": "commitment_signature",
      "trigger": "tracks_registered",
      "required_role": "course_committee",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "ta_approved_commitment",
          "recipients": [
            "student"
          ]
        }
      ]
    },
    {
      "from": "commitment_signature",
      "to": "ta_registered",
      "trigger": "commitment_signed",
      "required_role": "student",
      "description_fa": "امضای OTP — اضافه به لیست کمک‌مدرسین"
    }
  ],
  "forms": [
    {
      "code": "ta_supervision_decision",
      "name_fa": "تصمیم کمیته نظارت — ارتقا به کمک‌مدرس",
      "used_in_state": "supervision_review",
      "fields": [
        {
          "name": "ta_eligibility_summary_fa",
          "label_fa": "خلاصه احراز خودکار",
          "type": "readonly"
        },
        {
          "name": "result",
          "label_fa": "نتیجه بررسی",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "approve",
              "label_fa": "تایید صلاحیت"
            },
            {
              "value": "reject",
              "label_fa": "رد صلاحیت"
            }
          ]
        },
        {
          "name": "notes",
          "label_fa": "توضیحات",
          "type": "textarea"
        }
      ]
    },
    {
      "code": "ta_interview_schedule",
      "name_fa": "تنظیم وقت مصاحبه کمک‌مدرس",
      "used_in_state": "interview_scheduling",
      "fields": [
        {
          "name": "interview_date",
          "label_fa": "تاریخ مصاحبه",
          "type": "date_picker",
          "required": true
        },
        {
          "name": "interview_time",
          "label_fa": "ساعت مصاحبه",
          "type": "time_picker",
          "required": true
        },
        {
          "name": "meeting_type",
          "label_fa": "نحوه برگزاری",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "in_person",
              "label_fa": "حضوری"
            },
            {
              "value": "online",
              "label_fa": "آنلاین"
            }
          ]
        }
      ]
    },
    {
      "code": "ta_interview_result",
      "name_fa": "نتیجه مصاحبه و رسته",
      "used_in_state": "interview_held",
      "fields": [
        {
          "name": "result",
          "label_fa": "نتیجه مصاحبه",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "approve",
              "label_fa": "تایید"
            },
            {
              "value": "reject",
              "label_fa": "رد"
            }
          ]
        },
        {
          "name": "tracks",
          "label_fa": "رسته‌های کمک‌مدرس (پیشنهادی پس از مصاحبه)",
          "type": "multi_select",
          "options_source": {
            "type": "course_committee_tracks"
          }
        }
      ]
    },
    {
      "code": "ta_track_confirmation",
      "name_fa": "ثبت نهایی رسته‌های کمک‌مدرس",
      "used_in_state": "track_selection",
      "fields": [
        {
          "name": "tracks",
          "label_fa": "رسته‌های توافق‌شده",
          "type": "multi_select",
          "required": true,
          "options_source": {
            "type": "course_committee_tracks"
          }
        },
        {
          "name": "courses",
          "label_fa": "دروس مجاز کمک‌مدرس",
          "type": "multi_select",
          "required": true,
          "options_source": {
            "type": "course_catalog"
          },
          "description_fa": "فقط در دروس انتخاب‌شده می‌تواند کمک‌مدرس شود؛ در لیست انتساب سایر دروس نمایش داده نمی‌شود."
        }
      ]
    },
    {
      "code": "ta_commitment_signature",
      "name_fa": "امضای تعهدنامه کمک‌مدرس",
      "used_in_state": "commitment_signature",
      "fields": [
        {
          "name": "acknowledge",
          "label_fa": "پذیرش تعهدنامه",
          "type": "checkbox",
          "rules_link_href": "/guide#institute-rules",
          "rules_link_label_fa": "تعهدنامه اعضای هیئت علمی و کمک‌مدرسین",
          "required": true
        },
        {
          "name": "otp_code",
          "label_fa": "کد تأیید پیامکی",
          "type": "step_otp",
          "required": true
        }
      ]
    }
  ]
}
