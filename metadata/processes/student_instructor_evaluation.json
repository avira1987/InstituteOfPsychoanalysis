{
  "process": {
    "code": "student_instructor_evaluation",
    "name_fa": "ارزیابی دانشجو از مدرسین",
    "name_en": "Student Evaluation of Instructors",
    "number": 57,
    "description": "ارزیابی مستمر اساتید با حفظ گمنامی دانشجویان. Trigger: دقیقاً دو هفته قبل از پایان ترم، ارسال پیامک با لینک فرم. پر کردن فرم اختیاری. جداسازی هویت و ذخیره پاسخ‌ها به‌صورت ناشناس. داشبورد مدیریتی با نمودار دایره‌ای و میانگین در پورتال مدرس، کمیته دروس و کمیته پژوهش.",
    "initial_state": "evaluation_open",
    "initial_role": "student",
    "requires_form": true
  },
  "states": [
    {
      "code": "evaluation_open",
      "name_fa": "مهلت ارزیابی — دانشجو فرم را تکمیل می‌کند",
      "type": "initial",
      "assigned_role": "student"
    },
    {
      "code": "evaluation_closed",
      "name_fa": "پایان مهلت — محاسبات و توزیع نتایج",
      "type": "terminal",
      "assigned_role": "system"
    }
  ],
  "transitions": [
    {
      "from": "evaluation_open",
      "to": "evaluation_closed",
      "trigger": "evaluation_submitted",
      "required_role": "student",
      "description_fa": "ثبت فرم ارزیابی توسط دانشجو",
      "actions": [
        {
          "type": "record_evaluation_submission"
        }
      ]
    },
    {
      "from": "evaluation_open",
      "to": "evaluation_closed",
      "trigger": "deadline_reached",
      "description_fa": "پایان مهلت ارزیابی — محاسبه میانگین، نمودار دایره‌ای، توزیع در پورتال مدرس و کمیته‌ها",
      "required_role": "system",
      "actions": [
        {
          "type": "record_evaluation_closed"
        }
      ]
    }
  ],
  "forms": [
    {
      "code": "instructor_evaluation_form",
      "name_fa": "فرم ارزیابی کیفیت تدریس اساتید",
      "used_in_state": "evaluation_open",
      "fields": [
        {
          "name": "course_name",
          "label_fa": "نام درس",
          "type": "readonly"
        },
        {
          "name": "instructor_name",
          "label_fa": "نام مدرس",
          "type": "readonly"
        },
        {
          "name": "overall_score",
          "label_fa": "نمره کلی کیفیت تدریس",
          "type": "select",
          "options": ["1", "2", "3", "4", "5"]
        },
        {
          "name": "teaching_clarity",
          "label_fa": "شفافیت و انتقال مطلب",
          "type": "select",
          "options": ["1", "2", "3", "4", "5"]
        },
        {
          "name": "interaction_quality",
          "label_fa": "کیفیت تعامل با دانشجویان",
          "type": "select",
          "options": ["1", "2", "3", "4", "5"]
        },
        {
          "name": "comments",
          "label_fa": "نظر یا پیشنهاد (اختیاری)",
          "type": "textarea"
        }
      ]
    },
    {
      "code": "evaluation_dashboard",
      "name_fa": "داشبورد گزارش ارزیابی مدرس",
      "used_in_state": "evaluation_closed",
      "description_fa": "نمای مدرس / کمیته دروس و پژوهش — نرخ مشارکت، نمره میانگین، نمودار دایره‌ای",
      "fields": [
        {
          "name": "participation_rate",
          "label_fa": "نرخ مشارکت دانشجویان",
          "type": "readonly"
        },
        {
          "name": "average_score",
          "label_fa": "میانگین نمره ارزیابی",
          "type": "readonly"
        },
        {
          "name": "chart_data",
          "label_fa": "داده‌های نمودار دایره‌ای",
          "type": "readonly"
        }
      ]
    }
  ],
  "scheduled_automation": {
    "mode": "calendar_date",
    "completion_role": "student",
    "triggers": [
      {
        "event": "evaluation_open",
        "source": "InstituteCalendar.evaluation_open_at"
      },
      {
        "event": "deadline_reached",
        "source": "InstituteCalendar.evaluation_close_at"
      }
    ]
  }
}
