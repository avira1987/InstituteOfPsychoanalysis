{
  "process": {
    "code": "intern_bulk_patient_referral",
    "name_fa": "ارجاع کلیه بیماران انترن به درمانگران دیگر",
    "name_en": "Bulk Referral of Intern Patients to Other Therapists",
    "number": 72,
    "description": "مسیر ساختاریافته ارجاع همه بیماران انترن: جلسه کمیته نظارت، ثبت شرایط ارجاع در پورتال، تیک و توضیح دانشجو برای هر بیمار، هشدار ۱۵ روزه، نقش کمیته درمان عموم، ارسال به مسئول هماهنگی‌ها، پیگیری با مهلت ۳ روز و هشدار به معاون مدیر داخلی.",
    "initial_state": "supervision_start",
    "initial_role": "supervision_committee",
    "requires_form": true
  },
  "states": [
    {
      "code": "supervision_start",
      "name_fa": "شروع فرایند و ثبت جلسه توسط کمیته نظارت",
      "type": "initial",
      "assigned_role": "supervision_committee",
      "metadata": {
        "operator_task_fa": "جلسه کمیته نظارت، شرایط ارجاع و لیست بیماران را ثبت کنید.",
        "operator_short_fa": "شروع فرایند و ثبت جلسه توسط کمیته نظارت"
      }
    },
    {
      "code": "referral_conditions_set",
      "name_fa": "ثبت برگزاری جلسه و شرایط ارجاع؛ همگام‌سازی پورتال دانشجو",
      "type": "intermediate",
      "assigned_role": "system"
    },
    {
      "code": "student_patient_log",
      "name_fa": "تیک و توضیح صحبت با هر بیمار توسط دانشجو",
      "type": "intermediate",
      "assigned_role": "student",
      "sla_days": 15,
      "metadata": {
        "student_short_fa": "تماس با بیماران و ثبت توضیحات",
        "student_task_fa": "برای هر بیمار تیک «صحبت انجام شد» را بزنید و نتیجهٔ تماس را بنویسید؛ سپس دکمهٔ ثبت را بزنید."
      }
    },
    {
      "code": "general_therapy_committee_review",
      "name_fa": "مشاهده و تکمیل اطلاعات توسط کمیته درمان عموم",
      "type": "intermediate",
      "assigned_role": "therapy_committee_executor",
      "metadata": {
        "operator_task_fa": "یادداشت‌های دانشجو را ببینید و برای هر بیمار اطلاعات ارجاع را تکمیل کنید.",
        "operator_short_fa": "مشاهده و تکمیل اطلاعات توسط کمیته درمان عموم"
      }
    },
    {
      "code": "coordination_followup",
      "name_fa": "پیگیری و ثبت ارجاع نهایی توسط مسئول هماهنگی‌ها",
      "type": "intermediate",
      "assigned_role": "therapy_education_coordinator",
      "sla_days": 3,
      "metadata": {
        "operator_task_fa": "برای هر بیمار تیک پیگیری را بزنید؛ حداکثر ۳ روز مهلت دارید.",
        "operator_short_fa": "پیگیری و ثبت ارجاع نهایی توسط مسئول هماهنگی‌ها"
      }
    },
    {
      "code": "completed",
      "name_fa": "پایان فرایند",
      "type": "terminal",
      "assigned_role": "system"
    }
  ],
  "transitions": [
    {
      "from": "supervision_start",
      "to": "referral_conditions_set",
      "trigger": "meeting_and_conditions_logged",
      "required_role": "supervision_committee",
      "description_fa": "ثبت زمان جلسه، برگزاری/عدم برگزاری، شرایط ارجاع؛ SMS به دانشجو؛ انتشار در پورتال دانشجو"
    },
    {
      "from": "referral_conditions_set",
      "to": "student_patient_log",
      "trigger": "patient_list_published",
      "description_fa": "نمایش لیست بیماران در لاگ؛ شروع مهلت ۱۵ روز و هشدار در صورت تاخیر",
      "required_role": "system"
    },
    {
      "from": "student_patient_log",
      "to": "general_therapy_committee_review",
      "trigger": "student_patient_contacts_done",
      "required_role": "student",
      "description_fa": "دانشجو تیک و توضیحات هر بیمار را ثبت کرد؛ پس از ۱۵ روز اعلان به کمیته درمان عموم و سایر سطوح"
    },
    {
      "from": "general_therapy_committee_review",
      "to": "coordination_followup",
      "trigger": "committee_referral_notes_complete",
      "required_role": "therapy_committee_executor",
      "description_fa": "کمیته درمان عموم لیست را تکمیل کرد؛ ارسال به مسئول هماهنگی‌ها"
    },
    {
      "from": "coordination_followup",
      "to": "completed",
      "trigger": "coordination_followup_complete",
      "required_role": "therapy_education_coordinator",
      "description_fa": "تیک پیگیری برای همه بیماران؛ مهلت ۳ روز؛ در صورت تاخیر هشدار به معاون مدیر داخلی — پایان",
      "actions": [
        {
          "type": "record_intern_referral"
        }
      ]
    }
  ],
  "forms": [
    {
