{
  "process": {
    "code": "supervision_session_reduction",
    "name_fa": "درخواست دانشجو برای کاهش جلسات هفتگی سوپرویژن",
    "name_en": "Student Request for Reducing Weekly Supervision Sessions",
    "description": "دو مسیر: الف) ۲+ جلسه در هفته → انتخاب جلسات برای حذف (حداقل ۱ باقی)، حذف، آزادسازی وقت، SMS. ب) ۱ جلسه در هفته → احراز ۱۵۰/۲۵۰/۷۵۰، انتخاب توالی (۲/۳/۴ هفته یک‌بار)، تایید سوپروایزر، ثبت، آزادسازی، SMS.",
    "initial_state": "initiated",
    "eligibility": "مسیر الف: ۲ یا بیشتر جلسه سوپرویژن در هفته. مسیر ب: ۱ جلسه در هفته با تکمیل ساعات."
  },
  "forms": [
    {
      "code": "supervision_reduction_session_selection",
      "title_fa": "انتخاب جلسات سوپرویژن برای حذف",
      "used_in_state": "session_selection",
      "fields": [
        {
          "name": "selected_sessions",
          "label_fa": "جلسات هفتگی سوپرویژن که باید حذف شوند",
          "type": "checkbox_list",
          "required": true,
          "source": "supervision_reduction_upcoming_sessions"
        }
      ]
    },
    {
      "code": "supervision_reduction_structure",
      "title_fa": "درخواست تغییر تواتر برگزاری جلسات سوپرویژن",
      "used_in_state": "structure_selection",
      "fields": [
        {
          "name": "frequency",
          "label_fa": "فاصلهٔ بین جلسات (هفته)",
          "type": "select",
          "required": true,
          "options": [
            { "value": "2", "label_fa": "دو هفته یک‌بار" },
            { "value": "3", "label_fa": "سه هفته یک‌بار" },
            { "value": "4", "label_fa": "چهار هفته یک‌بار" }
          ]
        },
        {
          "name": "day",
          "label_fa": "روز هفته",
          "type": "select",
          "required": true,
          "options": [
            { "value": "saturday", "label_fa": "شنبه" },
            { "value": "sunday", "label_fa": "یکشنبه" },
            { "value": "monday", "label_fa": "دوشنبه" },
            { "value": "tuesday", "label_fa": "سه‌شنبه" },
            { "value": "wednesday", "label_fa": "چهارشنبه" },
            { "value": "thursday", "label_fa": "پنج‌شنبه" },
            { "value": "friday", "label_fa": "جمعه" }
          ]
        },
        {
          "name": "time",
          "label_fa": "ساعت برگزاری (مثال 14:30)",
          "type": "text",
          "required": true
        },
        {
          "name": "structure_note",
          "label_fa": "توضیح کوتاه (اختیاری)",
          "type": "textarea",
          "required": false
        }
      ]
    }
  ],
  "states": [
    {
      "code": "initiated",
      "name_fa": "آغاز فرایند",
      "type": "initial",
      "assigned_role": "student",
      "metadata": {
        "student_short_fa": "شروع درخواست کاهش جلسات سوپرویژن",
        "student_task_fa": "دکمهٔ «ادامه و ثبت مرحله» را بزنید. اگر ۲ جلسه یا بیشتر در هفته دارید، جلسات مازاد را انتخاب می‌کنید؛ اگر ۱ جلسه دارید، مسیر کاهش تواتر (با احراز ساعات) بررسی می‌شود."
      }
    },
    {
      "code": "session_selection",
      "name_fa": "انتخاب جلسات برای حذف",
      "type": "intermediate",
      "assigned_role": "student",
      "metadata": {
        "student_short_fa": "انتخاب جلسات هفتگی برای حذف",
        "student_task_fa": "جلسات سوپرویژنی که می‌خواهید حذف کنید را در فرم تیک بزنید؛ حداقل یک جلسه در هفته باید باقی بماند. سپس «ادامه و ثبت مرحله» را بزنید."
      }
    },
    {
      "code": "multi_reduction_completed",
      "name_fa": "کاهش جلسات متعدد انجام شد",
      "type": "terminal",
      "assigned_role": "system"
    },
    {
      "code": "eligibility_blocked",
      "name_fa": "شرایط کاهش توالی احراز نشده",
      "type": "terminal",
      "assigned_role": "system"
    },
    {
      "code": "structure_selection",
      "name_fa": "تعیین ساختار جدید (توالی + روز و ساعت)",
      "type": "intermediate",
      "assigned_role": "student",
      "metadata": {
        "student_short_fa": "انتخاب توالی، روز و ساعت جدید",
        "student_task_fa": "ابتدا با سوپروایزر هماهنگ کنید؛ سپس توالی (۲/۳/۴ هفته یک‌بار)، روز و ساعت را در فرم وارد کنید و «ادامه و ثبت مرحله» را بزنید."
      }
    },
    {
      "code": "supervisor_review",
      "name_fa": "بررسی و تایید سوپروایزر",
      "type": "intermediate",
      "assigned_role": "supervisor",
      "metadata": {
        "operator_task_fa": "درخواست کاهش تواتر را ببینید؛ در صورت موافقت تأیید کنید، در غیر این صورت رد با توضیح.",
        "operator_short_fa": "بررسی و تایید سوپروایزر",
        "student_task_fa": "سوپروایزر در حال بررسی درخواست شماست؛ پس از اعلام نتیجه همین صفحه را تازه کنید."
      }
    },
    {
      "code": "frequency_reduction_completed",
      "name_fa": "کاهش توالی انجام شد",
      "type": "terminal",
      "assigned_role": "system"
    }
  ],
  "transitions": [
    {
      "from": "initiated",
      "to": "session_selection",
      "trigger": "process_link_clicked",
      "conditions": [
        "has_2_or_more_weekly_supervision_sessions"
      ],
      "description_fa": "۲ جلسه یا بیشتر — نمایش لیست جلسات برای انتخاب حذف",
      "required_role": "student"
    },
    {
      "from": "session_selection",
      "to": "multi_reduction_completed",
      "trigger": "sessions_selected",
      "required_role": "student",
      "conditions": [
        "supervision_reduction_leaves_at_least_1"
      ],
      "description_fa": "حداقل یک جلسه باقی — حذف انتخابی، آزادسازی وقت، SMS",
      "actions": [
        {
          "type": "remove_selected_supervision_sessions"
        },
        {
          "type": "release_supervisor_slots_to_available_sheet"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "supervision_session_reduction_multi",
          "recipients": [
            "student",
            "supervisor"
          ]
        }
      ]
    },
    {
      "from": "initiated",
      "to": "eligibility_blocked",
      "trigger": "process_link_clicked",
      "conditions": [
        "fewer_than_2_weekly_supervision_sessions",
        "completion_conditions_not_met"
      ],
      "description_fa": "۱ جلسه در هفته و ساعات تکمیل نشده — نمایش پیام و خاتمه",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "supervision_session_reduction_eligibility_blocked",
          "recipients": [
            "student"
          ]
        }
      ],
      "required_role": "student"
    },
    {
      "from": "initiated",
      "to": "structure_selection",
      "trigger": "process_link_clicked",
      "conditions": [
        "fewer_than_2_weekly_supervision_sessions",
        "therapy_threshold_met",
        "clinical_threshold_met",
        "supervision_threshold_met"
      ],
      "description_fa": "۱ جلسه در هفته با ساعات کامل — نمایش فرم انتخاب توالی",
      "required_role": "student"
    },
    {
      "from": "structure_selection",
      "to": "supervisor_review",
      "trigger": "frequency_day_time_entered",
      "required_role": "student",
      "description_fa": "دانشجو توالی و روز/ساعت را وارد کرد — ارسال به سوپروایزر"
    },
    {
      "from": "supervisor_review",
      "to": "frequency_reduction_completed",
      "trigger": "supervisor_approved",
      "required_role": "supervisor",
      "description_fa": "سوپروایزر تایید کرد — ثبت در LMS، حذف جلسه قبلی، آزادسازی، SMS",
      "actions": [
        {
          "type": "update_supervision_schedule_frequency"
        },
        {
          "type": "remove_weekly_session_from_student_schedule"
        },
        {
          "type": "release_supervisor_slots_to_available_sheet"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "supervision_session_reduction_approved",
          "recipients": [
            "student"
          ]
        }
      ]
    },
    {
      "from": "supervisor_review",
      "to": "structure_selection",
      "trigger": "supervisor_rejected",
      "required_role": "supervisor",
      "description_fa": "سوپروایزر رد کرد — توضیح یا پیشنهاد، بازگشت به دانشجو",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "supervision_session_reduction_rejected",
          "recipients": [
            "student"
          ]
        }
      ]
    }
  ]
}
