{
  "process": {
    "code": "article_writing_completion",
    "name_fa": "خاتمه درس مقاله‌نویسی جهت گزارش موردی",
    "name_en": "Article Writing for Case Report - Course Completion",
    "number": 69,
    "description": "ساختار آموزشی شناور و قانون‌مند. کلاس حداکثر ۲ ترم (یک سال)؛ ترم دوم مجاز اگر در ترم اول تیک تکمیل نخورده باشد. اخذ در ترم سوم و بعد برابر تخلف آموزشی، گزارش به کمیته نظارت. ماشه: تیک تکمیل توسط مدرس؛ بستن کلاس برای دانشجو؛ مهلت ۸ روزه درخواست دفاع و ۴ روزه فرم ارزیابی مدرس. پاسخ سوال ۷ و ۸ فرم در جدول گزارش عملکرد دانشجو ثبت می‌شود.",
    "initial_state": "course_active",
    "initial_role": "instructor",
    "requires_form": true
  },
  "states": [
    {
      "code": "course_active",
      "name_fa": "کلاس مقاله‌نویسی فعال",
      "type": "initial",
      "assigned_role": "instructor",
      "metadata": {
        "operator_task_fa": "برای دانشجویی که کارش تمام شده، تیک تکمیل را ثبت کنید.",
        "operator_short_fa": "کلاس مقاله‌نویسی فعال"
      }
    },
    {
      "code": "class_closed_student",
      "name_fa": "کلاس بسته شد - مهلت ۸ روزه درخواست دفاع",
      "type": "intermediate",
      "assigned_role": "student",
      "sla_days": 8
    },
    {
      "code": "instructor_eval_pending",
      "name_fa": "منتظر فرم ارزیابی مدرس (۴ روز)",
      "type": "intermediate",
      "assigned_role": "instructor",
      "metadata": {
        "operator_task_fa": "فرم ارزیابی کیفی (سوال ۷ و ۸) را ظرف ۴ روز تکمیل کنید.",
        "operator_short_fa": "منتظر فرم ارزیابی مدرس (۴ روز)"
      },
      "sla_days": 4
    },
    {
      "code": "completed_to_defense",
      "name_fa": "خاتمه کلاس - انتقال به فاز دفاع",
      "type": "terminal",
      "assigned_role": "system"
    },
    {
      "code": "student_delay_violation",
      "name_fa": "تاخیر دانشجو - گزارش تخلف",
      "type": "terminal",
      "assigned_role": "system"
    },
    {
      "code": "instructor_delay_violation",
      "name_fa": "تاخیر مدرس - گزارش تخلف",
      "type": "terminal",
      "assigned_role": "system"
    },
    {
      "code": "term3_violation",
      "name_fa": "اخذ در ترم سوم - گزارش تخلف",
      "type": "terminal",
      "assigned_role": "system"
    }
  ],
  "transitions": [
    {
      "from": "course_active",
      "to": "class_closed_student",
      "trigger": "completion_ticked",
      "required_role": "instructor",
      "description_fa": "تیک تکمیل - کلاس بسته شد"
    },
    {
      "from": "class_closed_student",
      "to": "instructor_eval_pending",
      "trigger": "defense_requested",
      "required_role": "student",
      "description_fa": "درخواست دفاع ثبت شد",
      "actions": [
        {
          "type": "record_article_milestone"
        }
      ]
    },
    {
      "from": "class_closed_student",
      "to": "student_delay_violation",
      "trigger": "sla_8days_breach",
      "conditions": [
        "article_student_8day_sla_breach"
      ],
      "description_fa": "تاخیر ۸ روزه - گزارش به کمیته نظارت",
      "required_role": "system"
    },
    {
      "from": "instructor_eval_pending",
      "to": "completed_to_defense",
      "trigger": "evaluation_submitted",
      "required_role": "instructor",
      "description_fa": "فرم ارزیابی تکمیل شد",
      "actions": [
        {
          "type": "record_student_performance_traits",
          "payload": {
            "source": "article_writing_completion"
          }
        }
      ]
    },
    {
      "from": "instructor_eval_pending",
      "to": "instructor_delay_violation",
      "trigger": "sla_4days_breach",
      "conditions": [
        "article_instructor_4day_sla_breach"
      ],
      "description_fa": "تاخیر ۴ روزه مدرس - گزارش تخلف",
      "required_role": "system"
    },
    {
      "from": "course_active",
      "to": "term3_violation",
      "trigger": "enrollment_term3_plus",
      "conditions": [
        "article_enrollment_term3_plus"
      ],
      "description_fa": "اخذ ترم سوم - گزارش تخلف آموزشی",
      "required_role": "system"
    }
  ],
  "forms": [
    {
      "code": "article_completion_tick_dashboard",
      "name_fa": "داشبورد ثبت تیک تکمیل",
      "used_in_state": "course_active",
      "note_fa": "حداکثر ۲ ترم (یک سال) برای تکمیل این درس مجاز است. اخذ در ترم سوم و بعد، گزارش تخلف آموزشی به کمیته نظارت دارد.",
      "fields": [
        {
          "name": "course_code",
          "label_fa": "کد/نام درس",
          "type": "readonly"
        },
        {
          "name": "enrollment_term",
          "label_fa": "ترم اخذ فعلی",
          "type": "readonly"
        },
        {
          "name": "students",
          "label_fa": "لیست دانشجویان و تیک تکمیل",
          "type": "dynamic_list",
          "fields": [
            {
              "name": "student_name",
              "label_fa": "نام دانشجو",
              "type": "readonly"
            },
            {
              "name": "student_id",
              "label_fa": "شناسه دانشجو",
              "type": "readonly"
            },
            {
              "name": "completed",
              "label_fa": "تکمیل شد",
              "type": "checkbox"
            }
          ]
        }
      ]
    },
    {
      "code": "article_student_evaluation_form",
      "name_fa": "فرم ارزیابی کیفی دانشجو",
      "used_in_state": "instructor_eval_pending",
      "note_fa": "پاسخ سوال ۷ و ۸ در جدول گزارش عملکرد دانشجو (کمیته نظارت) ثبت می‌شود. مهلت: ۴ روز پس از تیک تکمیل.",
      "fields": [
        {
          "name": "student_name",
          "label_fa": "نام دانشجو",
          "type": "readonly"
        },
        {
          "name": "q7_has_positive",
          "label_fa": "سوال ۷ — آیا ویژگی مثبت قابل توجهی مشاهده کردید؟",
          "type": "radio",
          "required": true,
          "options": [
            { "value": "yes", "label_fa": "بله" },
            { "value": "no", "label_fa": "خیر" }
          ]
        },
        {
          "name": "q7_positive_traits",
          "label_fa": "سوال ۷ — ویژگی‌های مثبت (یک یا چند مورد)",
          "type": "checkbox_list",
          "options_source": { "type": "trait_catalog", "kind": "positive" },
          "show_if": { "field": "q7_has_positive", "op": "eq", "value": "yes" },
          "required_if": { "field": "q7_has_positive", "op": "eq", "value": "yes" },
          "validation": { "min_selection": 1 }
        },
        {
          "name": "q7_positive_note",
          "label_fa": "سوال ۷ — توضیح تکمیلی (اختیاری)",
          "type": "textarea",
          "show_if": { "field": "q7_has_positive", "op": "eq", "value": "yes" }
        },
        {
          "name": "q8_has_negative",
          "label_fa": "سوال ۸ — آیا ویژگی منفی قابل توجهی مشاهده کردید؟",
          "type": "radio",
          "required": true,
          "options": [
            { "value": "yes", "label_fa": "بله" },
            { "value": "no", "label_fa": "خیر" }
          ]
        },
        {
          "name": "q8_negative_traits",
          "label_fa": "سوال ۸ — ویژگی‌های منفی (یک یا چند مورد)",
          "type": "checkbox_list",
          "options_source": { "type": "trait_catalog", "kind": "negative" },
          "show_if": { "field": "q8_has_negative", "op": "eq", "value": "yes" },
          "required_if": { "field": "q8_has_negative", "op": "eq", "value": "yes" },
          "validation": { "min_selection": 1 }
        },
        {
          "name": "q8_negative_note",
          "label_fa": "سوال ۸ — توضیح تکمیلی (اختیاری)",
          "type": "textarea",
          "show_if": { "field": "q8_has_negative", "op": "eq", "value": "yes" }
        }
      ]
    }
  ],
  "scheduled_automation": {
    "mode": "instance_sla",
    "completion_role": "student",
    "triggers": [
