{
  "process": {
    "code": "ta_blog_content",
    "name_fa": "ثبت محتوای وبلاگ از محتوای درسی (کمک‌مدرس)",
    "name_en": "TA Blog Content from Class",
    "number": 46,
    "description": "پس از هر جلسه. کمک‌مدرس خلاصه کاربردی مباحث را در فیلد متنی می‌نویسد (حدود نیم صفحه A4). مهلت ۲۴ ساعت. تاخیر → violation_registration. مدرس ۴ روز بررسی. رد → اصلاح. تایید → پیش‌نویس مارکتینگ و امتیازدهی.",
    "initial_state": "session_ended",
    "trigger": "class_session_ended"
  },
  "states": [
    {
      "code": "session_ended",
      "name_fa": "جلسه کلاس پایان یافت",
      "type": "initial",
      "assigned_role": "system"
    },
    {
      "code": "ta_write",
      "name_fa": "نگارش محتوای وبلاگ",
      "type": "intermediate",
      "assigned_role": "teaching_assistant",
      "sla_hours": 24,
      "metadata": {
        "operator_task_fa": "خلاصهٔ کاربردی مباحث جلسه را مستقیماً در فیلد متنی بنویسید (حدود نیم صفحه A4). آپلود فایل مجاز نیست. مهلت ۲۴ ساعت.",
        "operator_short_fa": "نگارش محتوای وبلاگ"
      }
    },
    {
      "code": "instructor_review",
      "name_fa": "تایید علمی توسط مدرس",
      "type": "intermediate",
      "assigned_role": "instructor",
      "sla_days": 4,
      "metadata": {
        "operator_task_fa": "متن وبلاگ را فقط‌خواندنی ببینید؛ «قابل قبول» یا «غیر قابل قبول» (با توضیح اجباری در صورت رد).",
        "operator_short_fa": "تایید علمی توسط مدرس"
      }
    },
    {
      "code": "rejected_revision",
      "name_fa": "رد — اصلاح",
      "type": "intermediate",
      "assigned_role": "teaching_assistant",
      "metadata": {
        "operator_task_fa": "بازخورد مدرس را ببینید؛ متن را اصلاح و مجدداً ارسال کنید.",
        "operator_short_fa": "رد — اصلاح"
      }
    },
    {
      "code": "approved_marketing_draft",
      "name_fa": "تایید — پیش‌نویس مارکتینگ",
      "type": "terminal",
      "assigned_role": "system"
    }
  ],
  "transitions": [
    {
      "from": "session_ended",
      "to": "ta_write",
      "trigger": "process_started",
      "description_fa": "کمک‌مدرس متن را در فیلد متنی می‌نویسد (حدود نیم صفحه A4)",
      "required_role": "system"
    },
    {
      "from": "ta_write",
      "to": "instructor_review",
      "trigger": "content_submitted",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "ta_blog_ready_for_review",
          "recipients": [
            "instructor"
          ]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "instructor_review",
      "to": "rejected_revision",
      "trigger": "rejected",
      "required_role": "instructor",
      "description_fa": "غیر قابل قبول — توضیحات الزامی"
    },
    {
      "from": "instructor_review",
      "to": "approved_marketing_draft",
      "trigger": "accepted",
      "required_role": "instructor",
      "description_fa": "قابل قبول — پیش‌نویس مارکتینگ و امتیازدهی"
    },
    {
      "from": "rejected_revision",
      "to": "instructor_review",
      "trigger": "revised_and_submitted",
      "required_role": "teaching_assistant",
      "description_fa": "اصلاح و ارسال مجدد"
    }
  ],
  "forms": [
    {
      "code": "ta_blog_write_form",
      "name_fa": "ثبت محتوای وبلاگ",
      "used_in_state": ["ta_write", "rejected_revision"],
      "editable_by": ["teaching_assistant", "admin", "staff"],
      "fields": [
        {
          "name": "course_name",
          "label_fa": "نام درس",
          "type": "readonly"
        },
        {
          "name": "session_number",
          "label_fa": "شماره جلسه",
          "type": "readonly"
        },
        {
          "name": "session_date",
          "label_fa": "تاریخ جلسه",
          "type": "readonly"
        },
        {
          "name": "blog_content",
          "label_fa": "متن وبلاگ",
          "type": "textarea",
          "required": true,
          "max_length": 2500,
          "note_fa": "فقط متن — آپلود فایل مجاز نیست. حدود نیم صفحه A4."
        }
      ]
    },
    {
      "code": "ta_blog_instructor_review",
      "name_fa": "بررسی متن وبلاگ توسط مدرس",
      "used_in_state": "instructor_review",
      "editable_by": ["instructor", "admin", "staff"],
      "fields": [
        {
          "name": "course_name",
          "label_fa": "نام درس",
          "type": "readonly"
        },
        {
          "name": "session_number",
          "label_fa": "شماره جلسه",
          "type": "readonly"
        },
        {
          "name": "blog_content",
          "label_fa": "متن وبلاگ (فقط‌خواندنی)",
          "type": "readonly"
        },
        {
          "name": "review_decision",
          "label_fa": "نتیجه بررسی",
          "type": "select",
          "required": true,
          "options": [
            { "value": "accepted", "label_fa": "قابل قبول" },
            { "value": "rejected", "label_fa": "غیر قابل قبول" }
          ]
        },
        {
          "name": "rejection_notes",
          "label_fa": "توضیح رد",
          "type": "textarea",
          "required_if": {
            "field": "review_decision",
            "op": "eq",
            "value": "rejected"
          }
        }
      ]
    }
  ]
}
