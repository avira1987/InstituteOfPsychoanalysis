          "accept": "image/*,application/pdf",
          "required": true
        },
        {
          "name": "national_card_back",
          "label_fa": "تصویر پشت کارت ملی",
          "type": "file_upload",
          "accept": "image/*,application/pdf",
          "required": true
        },
        {
          "name": "bachelor_degree",
          "label_fa": "مدرک کارشناسی یا پزشکی عمومی",
          "type": "file_upload",
          "accept": "image/*,application/pdf",
          "required": true
        },
        {
          "name": "master_degree",
          "label_fa": "مدرک کارشناسی ارشد (در صورت وجود)",
          "type": "file_upload",
          "accept": "image/*,application/pdf",
          "required": false
        },
        {
          "name": "latest_certificate",
          "label_fa": "آخرین مدرک تحصیلی",
          "type": "file_upload",
          "accept": "image/*,application/pdf",
          "required": true
        }
      ],
      "submit_label_fa": "ارسال مدارک"
    },
    {
      "code": "course_selection_form",
      "name_fa": "فرم انتخاب درس ترم اول",
      "used_in_state": "course_selection",
      "note_fa": "درس‌های نمایش‌داده‌شده بر اساس نتیجه مصاحبه فیلتر شده‌اند",
      "fields": [
        {
          "name": "selected_courses",
          "label_fa": "انتخاب درس",
          "type": "checkbox_list",
          "source": "available_courses_by_admission_type",
          "max_selection_source": "admission.allowed_course_count",
          "required": true
        }
      ],
      "submit_label_fa": "تأیید و ادامه به پرداخت"
    },
    {
      "code": "payment_form",
      "name_fa": "فرم پرداخت شهریه",
      "used_in_state": "payment",
      "fields": [
        {
          "name": "payment_method",
          "label_fa": "روش پرداخت",
          "type": "radio",
          "options": [
            {
              "value": "cash",
              "label_fa": "پرداخت نقدی (یکجا)"
            },
            {
              "value": "installment",
              "label_fa": "پرداخت اقساطی"
            }
          ],
          "required": true,
          "note_fa": "دانشجوی تک‌درس فقط مجاز به پرداخت نقدی است",
          "restricted_when": {
            "admission_type": "single_course",
            "allowed_values": [
              "cash"
            ]
          }
        },
        {
          "name": "installment_count",
          "label_fa": "تعداد اقساط",
          "type": "select",
          "options": [
            {
              "value": 2,
              "label_fa": "۲ قسط"
            },
            {
              "value": 3,
              "label_fa": "۳ قسط"
            },
            {
              "value": 4,
              "label_fa": "۴ قسط"
            }
          ],
          "show_if": {"field": "payment_method", "op": "eq", "value": "installment"},
          "required_if": {"field": "payment_method", "op": "eq", "value": "installment"},
          "visible_when": "payment_method == 'installment'",
          "required_when": "payment_method == 'installment'"
        }
      ],
      "installment_schedule": {
        "installment_1": "هنگام ثبت‌نام",
        "installment_2": "۲۵ روز پس از شروع کلاس‌ها",
        "subsequent": "هر ۲۵ روز پس از قسط قبل",
        "reminder": "۱ هفته قبل از سررسید هر قسط — پیامک یادآوری"
      },
      "submit_label_fa": "پرداخت"
    }
  ],
  "scheduled_automation": {
    "mode": "reminder_queue",
    "completion_role": "student",
    "context_required": [
      "next_installment_due_at"
    ],
    "triggers": [
      {
        "event": "installment_due_date_passed",
        "when": {
          "state": "registration_complete",
          "context_field": "next_installment_due_at",
          "op": "lte_today"
        },
        "actor_role": "system"
      }
    ]
  }
}
