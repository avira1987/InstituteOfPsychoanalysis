      "from": "result_full_admission",
      "to": "documents_upload",
      "trigger": "proceed_to_documents",
      "description_fa": "ارسال پیامک فهرست مدارک با مهلت ۲ روز (خودکار پس از نتیجهٔ پذیرش)",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "required_documents_list",
          "recipients": [
            "applicant"
          ]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "documents_upload",
      "to": "documents_review",
      "trigger": "documents_submitted",
      "required_role": "applicant",
      "description_fa": "متقاضی مدارک و تعهدنامه (تأیید با کد پیامک) را آپلود کرد"
    },
    {
      "from": "documents_review",
      "to": "documents_incomplete",
      "trigger": "documents_rejected",
      "required_role": "admissions_officer",
      "description_fa": "مدارک ناقص — ارسال لیست نواقص با مهلت ۲ روز",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "documents_deficiency_list",
          "recipients": [
            "applicant"
          ],
          "description_fa": "ارسال لیست نواقص مدارک"
        }
      ]
    },
    {
      "from": "documents_incomplete",
      "to": "documents_review",
      "trigger": "documents_resubmitted",
      "required_role": "applicant",
      "description_fa": "متقاضی مدارک تکمیلی را آپلود کرد"
    },
    {
      "from": "documents_review",
      "to": "credentials_created",
      "trigger": "documents_approved",
      "required_role": "admissions_officer",
      "description_fa": "مدارک تأیید شد — ایجاد حساب کاربری و ارسال رمز عبور",
      "actions": [
        {
          "type": "create_user_account",
          "description_fa": "اجاد حساب کاربر داشج در LMS"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "lms_credentials",
          "recipients": [
            "applicant"
          ],
          "description_fa": "ارسا ا کاربر  رز عبر LMS"
        }
      ]
    },
    {
      "from": "credentials_created",
      "to": "course_selection",
      "trigger": "student_logged_in",
      "required_role": "student",
      "description_fa": "دانشجو وارد LMS شد — نمایش دروس مجاز بر اساس نتیجه مصاحبه"
    },
    {
      "from": "course_selection",
      "to": "payment",
      "trigger": "courses_selected",
      "required_role": "student",
      "description_fa": "دانشجو دروس را انتخاب و تایید کرد — هدایت به پرداخت شهریه",
      "constraints": [
        "courses_within_admission_type_limit"
      ]
    },
    {
      "from": "payment",
      "to": "registration_complete",
      "trigger": "payment_completed",
      "description_fa": "پرداخت کامل (نقدی یا اقساط) — ثبت‌نام نهایی",
      "actions": [
        {
          "type": "register_courses_in_portal"
        },
        {
          "type": "create_online_class_links",
          "description_fa": "اجاد ک کاس آا"
        },
        {
          "type": "record_accounting",
          "kind": "tuition"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "tuition_payment_to_accounting",
          "recipients": [
            "accounting"
          ]
        },
        {
          "type": "schedule_installment_reminders",
          "condition": "payment_method == 'installment'",
          "reminder_days_before": 7,
          "description_fa": "برنامه‌ریزی یادآوری اقساط: ۷ روز قبل از سررسید هر قسط"
        },
        {
          "type": "merge_instance_context",
          "mode": "initial_payment"
        }
      ],
      "required_role": "system"
    },
    {
      "from": "payment",
      "to": "payment",
      "trigger": "payment_failed",
      "description_fa": "پرداخت ناموفق — بازگشت برای تلاش مجدد",
      "required_role": "system"
    },
    {
      "from": "registration_complete",
      "to": "installment_overdue",
      "trigger": "installment_due_date_passed",
      "conditions": [
        "installment_not_paid"
      ],
      "description_fa": "قسط معوق — بلاک ثبت حضور و غیاب",
      "actions": [
        {
          "type": "block_attendance_registration"
        },
        {
          "type": "set_installment_portal_lock"
        },
        {
          "type": "notify_instructor",
          "message_fa": "هشدار: امکان ثبت حضور برای این دانشجو به دلیل عدم تسویه بدهی شهریه وجود ندارد. لطفاً گزینه غیبت را ثبت نمایید."
        }
      ],
      "required_role": "system"
    },
    {
      "from": "installment_overdue",
      "to": "registration_complete",
      "trigger": "overdue_installment_paid",
      "description_fa": "قسط معوق پرداخت شد — رفع بلاک حضور و غیاب",
      "actions": [
        {
          "type": "unblock_attendance_registration"
        },
        {
          "type": "clear_installment_portal_lock"
        },
        {
          "type": "merge_instance_context",
          "mode": "installment_paid"
        }
      ],
      "required_role": "system"
    }
  ],
  "forms": [
    {
      "code": "interview_result_form",
      "name_fa": "فرم ثبت نتیجه مصاحبه (محرمانه)",
      "used_in_state": "interview_completed",
      "confidential": true,
      "visible_to": [
        "interviewer",
        "admissions_officer",
        "admin"
      ],
      "editable_by": [
        "interviewer",
        "admissions_officer",
        "admin"
      ],
      "note_fa": "این فرم محرمانه است و برای دانشجو قابل مشاهده نیست",
      "fields": [
        {
          "name": "interview_result",
          "label_fa": "نتیجه مصاحبه",
          "type": "radio",
          "options": [
            {
              "value": "conditional_therapy",
              "label_fa": "پذیرش مشروط به شروع درمان شخصی"
            },
            {
              "value": "single_course",
              "label_fa": "فقط مجاز به اخذ درس تئوری روانکاوی ۱"
            },
            {
              "value": "full_admission",
              "label_fa": "پذیرش کامل (بدون شرط)"
            },
            {
              "value": "rejected",
              "label_fa": "رد درخواست"
            }
          ],
          "required": true
        },
        {
          "name": "allowed_course_count",
          "label_fa": "تعداد درس جاز",
          "type": "number",
          "min": 1,
          "max": 5,
          "visible_when": "interview_result in ['conditional_therapy', 'full_admission']",
          "required_when": "interview_result in ['conditional_therapy', 'full_admission']"
        },
        {
          "name": "rejection_reason",
          "label_fa": "علت عدم پذیرش (محرمانه)",
          "type": "textarea",
          "visible_when": "interview_result == 'rejected'",
          "required_when": "interview_result == 'rejected'"
        },
        {
          "name": "interviewer_notes",
          "label_fa": "یادداشت‌های مصاحبه‌گر",
          "type": "textarea",
          "required": false
        }
      ],
      "submit_label_fa": "ثبت نتیجه"
    },
    {
      "code": "documents_upload_form",
      "name_fa": "فرم آپلود مدارک",
      "used_in_state": "documents_upload",
      "editable_by": [
        "admissions_officer",
        "admin"
      ],
      "note_fa": "لطفاً مدارک زیر را با کیفیت خوانا و واضح بارگذاری کنید. فرمت‌های مجاز: تصویر یا PDF.",
      "fields": [
        {
          "name": "digital_commitment",
          "label_fa": "پذیرش قوانین و تعهدنامه ورود به دوره آشنایی",
          "type": "checkbox",
          "rules_link_href": "/guide#institute-rules",
          "rules_link_label_fa": "قوانین و تعهدنامه انستیتو",
          "required": true,
          "show_in_document_summary": true
        },
        {
          "name": "otp_code",
          "label_fa": "کد تأیید پیامکی پذیرش قوانین",
          "type": "step_otp",
          "required": true
        },
        {
          "name": "photo",
          "label_fa": "عکس پرسنلی",
          "type": "file_upload",
          "accept": "image/*",
          "required": true
        },
        {
          "name": "id_card",
          "label_fa": "تصویر صفحه اول شناسنامه",
