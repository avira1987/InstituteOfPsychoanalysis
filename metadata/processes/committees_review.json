{
  "process": {
    "code": "committees_review",
    "name_fa": "بررسی کمیته‌های نظارت و آموزش (زیرفرایند ب)",
    "name_en": "Supervision and Education Committees Review (Sub-process B)",
    "description": "زیرفرایند ب قطع زودرس. کمیته نظارت (۳ روز) پیشنهاد، کمیته آموزش (۶ روز) حکم نهایی. ادامه → Unlock و ۵ روز. قطع → اخراج کامل، نامه رسمی، انترن → patient_referral.",
    "initial_state": "supervision_review",
    "triggered_by": [
      "therapy_early_termination",
      "specialized_commission_review"
    ],
    "trigger_conditions": [
      "termination_reason_4",
      "commission_eligibility_rejected"
    ]
  },
  "forms": [
    {
      "code": "supervision_recommendation",
      "title_fa": "پیشنهاد کمیته نظارت",
      "description_fa": "پرونده را بررسی کنید، پیشنهاد مشورتی را ثبت کنید، سپس دکمهٔ «ثبت پیشنهاد» را بزنید.",
      "used_in_state": "supervision_review",
      "visible_to": [
        "supervision_committee",
        "monitoring_committee_officer",
        "admin",
        "staff"
      ],
      "fields": [
        {
          "name": "entry_source_display",
          "label_fa": "منبع ورود به زیرفرایند",
          "type": "readonly",
          "required": false
        },
        {
          "name": "termination_reason_display",
          "label_fa": "علت قطع درمان (گزارش درمانگر)",
          "type": "readonly",
          "required": false
        },
        {
          "name": "commission_opinion_display",
          "label_fa": "نظر کمیسیون تخصصی (در صورت وجود)",
          "type": "readonly",
          "required": false
        },
        {
          "name": "nezarat_recommendation_code",
          "label_fa": "پیشنهاد کمیته نظارت",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "continue",
              "label_fa": "پیشنهاد الف — مشکل قابل اغماض است (ادامه آموزش)"
            },
            {
              "value": "terminate",
              "label_fa": "پیشنهاد ب — تخلف محرز است (قطع آموزش)"
            }
          ]
        },
        {
          "name": "nezarat_recommendation_fa",
          "label_fa": "توضیحات و مستندات پیشنهاد",
          "type": "textarea",
          "required": true
        }
      ]
    },
    {
      "code": "education_verdict",
      "title_fa": "حکم نهایی کمیته آموزش",
      "description_fa": "پیش از زدن دکمهٔ «ادامه آموزش» یا «قطع قطعی»، فرم را تکمیل و ثبت کنید.",
      "used_in_state": "education_review",
      "visible_to": [
        "education_committee",
        "deputy_education",
        "admin",
        "staff"
      ],
      "fields": [
        {
          "name": "termination_reason_display",
          "label_fa": "علت قطع درمان (گزارش درمانگر)",
          "type": "readonly",
          "required": false
        },
        {
          "name": "commission_opinion_display",
          "label_fa": "نظر کمیسیون تخصصی",
          "type": "readonly",
          "required": false
        },
        {
          "name": "supervision_recommendation_display",
          "label_fa": "پیشنهاد کمیته نظارت",
          "type": "readonly",
          "required": false
        },
        {
          "name": "education_verdict_notes_fa",
          "label_fa": "یادداشت جلسه و مستندات حکم (اختیاری)",
          "type": "textarea",
          "required": false
        }
      ]
    }
  ],
  "states": [
    {
      "code": "supervision_review",
      "name_fa": "بررسی کمیته نظارت",
      "type": "initial",
      "assigned_role": "supervision_committee",
      "sla_days": 3,
      "metadata": {
        "operator_task_fa": "بررسی/صدور مجوز طبق دستور کار.",
        "operator_short_fa": "بررسی کمیته نظارت"
      }
    },
    {
      "code": "education_review",
      "name_fa": "تصمیم‌گیری کمیته آموزش",
      "type": "intermediate",
      "assigned_role": "education_committee",
      "sla_days": 6,
      "metadata": {
        "operator_task_fa": "بررسی پرونده در جلسه کمیته آموزش.",
        "operator_short_fa": "تصمیم‌گیری کمیته آموزش"
      }
    },
    {
      "code": "awaiting_student_restart",
      "name_fa": "در انتظار بازگشت به درمان (مهلت ۵ روز)",
      "type": "intermediate",
      "assigned_role": "student",
      "sla_days": 5
    },
    {
      "code": "restart_completed",
      "name_fa": "دانشجو درمان را از سر گرفت",
      "type": "terminal",
      "assigned_role": "system"
    },
    {
      "code": "violation_no_restart",
      "name_fa": "عدم آغاز در مهلت — ثبت تخلف",
      "type": "terminal",
      "assigned_role": "system"
    },
    {
      "code": "education_terminated",
      "name_fa": "قطع قطعی آموزش (اخراج)",
      "type": "terminal",
      "assigned_role": "system"
    }
  ],
  "transitions": [
    {
      "from": "supervision_review",
      "to": "education_review",
      "trigger": "supervision_recommendation_submitted",
      "required_role": "supervision_committee",
      "description_fa": "کمیته نظارت پیشنهاد ثبت کرد",
      "actions": [
        {
          "type": "store_nezarat_recommendation"
        },
        {
          "type": "create_education_committee_task"
        }
      ]
    },
    {
      "from": "supervision_review",
      "to": "supervision_review",
      "trigger": "supervision_sla_breach",
      "description_fa": "۳ روز بدون تعیین جلسه — اطلاع به معاون",
      "actions": [
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "supervision_committee_sla_breach",
          "recipients": [
            "deputy_education"
          ]
        }
      ],
      "required_role": "system"
    },
    {
      "from": "education_review",
      "to": "awaiting_student_restart",
      "trigger": "education_verdict_continue",
      "required_role": "education_committee",
      "description_fa": "حکم برائت / ادامه آموزش",
      "actions": [
        {
          "type": "set_student_status",
          "status": "approved"
        },
        {
          "type": "send_unlock_to_lms"
        },
        {
          "type": "unlock_student_therapist_selection"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "therapy_early_termination_standard",
          "recipients": [
            "student"
          ]
        },
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "therapy_early_termination_standard",
          "recipients": [
            "student"
          ]
        }
      ]
    },
    {
      "from": "education_review",
      "to": "education_terminated",
      "trigger": "education_verdict_terminate",
      "required_role": "education_committee",
      "description_fa": "حکم محکومیت / قطع قطعی آموزش",
      "actions": [
        {
          "type": "record_termination_date"
        },
        {
          "type": "deactivate_student_account"
        },
        {
          "type": "revoke_student_access"
        },
        {
          "type": "cancel_all_future_sessions"
        },
        {
          "type": "block_future_enrollment"
        },
        {
          "type": "generate_termination_letter"
        },
        {
          "type": "archive_letter_in_student_file"
        },
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "education_termination_notice",
          "recipients": [
            "student"
          ]
        },
        {
          "type": "notification",
          "notification_type": "email",
          "template": "education_termination_notice",
          "recipients": [
            "student"
          ]
        },
        {
          "type": "start_process",
          "process_code": "patient_referral",
          "payload": {
            "reason": "education_terminated_intern"
          },
          "run_if_intern": true
        }
      ]
    },
    {
      "from": "education_review",
      "to": "education_review",
      "trigger": "education_sla_breach",
      "description_fa": "۶ روز بدون تعیین — ثبت لاگ",
      "actions": [
        {
          "type": "log_sla_breach_in_portals"
        }
      ],
      "required_role": "system"
    },
    {
      "from": "awaiting_student_restart",
      "to": "restart_completed",
      "trigger": "student_restarted_therapy",
      "description_fa": "دانشجو در مهلت درمان را از سر گرفت",
      "required_role": "student"
    },
    {
      "from": "awaiting_student_restart",
      "to": "violation_no_restart",
      "trigger": "sla_5days_breach",
      "description_fa": "مهلت ۵ روز بدون آغاز دوباره",
      "actions": [
        {
          "type": "start_process",
          "process_code": "violation_registration",
          "payload": {
            "reason": "no_restart_after_committees_approval"
          }
        },
        {
          "type": "notification",
          "notification_type": "in_app",
          "template": "violation_no_restart_5days",
          "recipients": [
            "monitoring_committee_officer"
          ]
        }
      ],
      "required_role": "system"
    }
  ]
}
