{
  "process": {
    "code": "patient_referral",
    "name_fa": "ارجاع بیماران انترن به درمانگران دیگر",
    "name_en": "Patient Referral (Intern)",
    "description": "وقتی انترن در وقفه بلند (≥۴۲ روز) یا وقفه ۲ ترمی تایید شده یا قطع در committees_review؛ بیماران وی به درمانگران دیگر ارجاع می‌شوند.",
    "initial_state": "referral_triggered",
    "initial_role": "monitoring_committee_officer"
  },
  "forms": [
    {
      "code": "patient_list_form",
      "title_fa": "لیست بیماران انترن برای ارجاع",
      "used_in_state": "referral_triggered",
      "fields": [
        {
          "name": "referral_patients",
          "label_fa": "بیماران قابل ارجاع",
          "type": "table",
          "required": true,
          "min_rows": 1,
          "columns": [
            {
              "name": "patient_label",
              "label_fa": "شناسه / نام بیمار",
              "type": "text",
              "required": true
            }
          ]
        }
      ],
      "submit_label_fa": "ثبت لیست بیماران"
    },
    {
      "code": "patient_assignment_form",
      "title_fa": "تخصیص درمانگر جایگزین",
      "used_in_state": "patients_listed",
      "fields": [
        {
          "name": "referral_patients",
          "label_fa": "تخصیص درمانگر به هر بیمار",
          "type": "table",
          "required": true,
          "min_rows": 1,
          "columns": [
            {
              "name": "patient_label",
              "label_fa": "شناسه / نام بیمار",
              "type": "text",
              "required": true
            },
            {
              "name": "assigned_therapist_user_id",
              "label_fa": "شناسه کاربر درمانگر جایگزین",
              "type": "text",
              "required": true
            }
          ]
        }
      ],
      "submit_label_fa": "ثبت تخصیص"
    }
  ],
  "states": [
    {
      "code": "referral_triggered",
      "name_fa": "ارجاع راه‌اندازی شد",
      "type": "initial",
      "assigned_role": "monitoring_committee_officer",
      "metadata": {
        "operator_task_fa": "لیست بیماران انترن را در فرم ثبت کنید، سپس «ثبت لیست» را بزنید.",
        "operator_short_fa": "ثبت لیست بیماران انترن"
      }
    },
    {
      "code": "patients_listed",
      "name_fa": "لیست بیماران انترن ثبت شد",
      "type": "intermediate",
      "assigned_role": "monitoring_committee_officer",
      "metadata": {
        "operator_task_fa": "برای هر بیمار درمانگر جایگزین را مشخص و ثبت کنید.",
        "operator_short_fa": "تخصیص درمانگر جایگزین"
      }
    },
    {
      "code": "therapists_assigned",
      "name_fa": "درمانگران جایگزین تخصیص یافتند",
      "type": "intermediate",
      "assigned_role": "monitoring_committee_officer",
      "metadata": {
        "operator_task_fa": "اطلاع‌رسانی به دانشجو و درمانگران تخصیص‌شده را ارسال کنید.",
        "operator_short_fa": "ارسال اطلاع ارجاع"
      }
    },
    {
      "code": "notifications_sent",
      "name_fa": "اطلاع‌رسانی به بیماران و درمانگران انجام شد",
      "type": "intermediate",
      "assigned_role": "system"
    },
    {
      "code": "closed",
      "name_fa": "ارجاع مختومه",
      "type": "terminal",
      "assigned_role": "system"
    }
  ],
  "transitions": [
    {
      "from": "referral_triggered",
      "to": "patients_listed",
      "trigger": "list_submitted",
      "required_role": "monitoring_committee_officer",
      "description_fa": "ثبت لیست بیماران انترن",
      "actions": [
        {
          "type": "persist_patient_referral_rows"
        }
      ]
    },
    {
      "from": "patients_listed",
      "to": "therapists_assigned",
      "trigger": "assignments_done",
      "required_role": "monitoring_committee_officer",
      "description_fa": "تخصیص درمانگر جایگزین به هر بیمار",
      "actions": [
        {
          "type": "persist_patient_referral_rows"
        }
      ]
    },
    {
      "from": "therapists_assigned",
      "to": "notifications_sent",
      "trigger": "notifications_done",
      "required_role": "monitoring_committee_officer",
      "description_fa": "ارسال اطلاع به بیماران و درمانگران",
      "actions": [
        {
          "type": "notification",
          "notification_type": "sms",
          "template": "patient_referral_notice",
          "recipients": [
            "student",
            "assigned_therapists"
          ]
        },
        {
          "type": "close_patient_referral_hub"
        }
      ]
    },
    {
      "from": "notifications_sent",
      "to": "closed",
      "trigger": "closed",
      "required_role": "system",
      "description_fa": "پرونده ارجاع بسته شد"
    }
  ]
}
